# Pinned versions of every tool and corpus source the corpus provisioning uses.
#
# One KEY=VALUE per line; `#` starts a comment line. Values carry no spaces or
# quotes. `corpus init` passes every entry except the local-tool pins to
# `docker build` as --build-arg, and the image hands the corpus revisions to
# the download scripts. An environment variable of the same name overrides a
# pin for one invocation:
#
#   VERAPDF_VERSION=1.30.2 make corpus-init
#
# Overriding a version without its digest drops the digest, so the image is
# pulled by tag. Provisioning records the resolved versions in
# testdata/<corpus>/versions.json, and `corpus run`, `baseline` and `check`
# refuse goldens recorded with other versions. A bump therefore means
# re-provisioning the goldens that depend on it and recapturing the baseline:
# see test/integration/README.md, "Tool versions".
#
# Every tool pin names a release, and every corpus revision is a tag or a
# commit SHA, never a branch.

# veraPDF CLI: the verapdf/cli image tagged v<VERAPDF_VERSION>, pinned to one
# build by its manifest digest (Docker Hub, pushed 2026-10-07). This build
# reports core, validation-model and apps 1.30.3, apps built 2026-10-07 13:52
# UTC, the build behind the compliance goldens.
VERAPDF_VERSION=1.30.3
VERAPDF_IMAGE_DIGEST=sha256:d565095c67a083e693aebf7d1a15784007370571053fc1aa5b502665b9a78f9c

# Node.js: the node:<NODE_VERSION>-<NODE_DEBIAN_RELEASE> base image, pinned by
# its multi-platform index digest. It also fixes the Debian release the apt
# utilities (git, curl, unzip, jq, parallel) come from.
NODE_VERSION=24.21.0
NODE_DEBIAN_RELEASE=bookworm
NODE_IMAGE_DIGEST=sha256:64af3819f9275802414d7cdc38c27e9d82bd564dec4d4da87d008255d36c63b4

# Java runtime for veraPDF, Mustang and KoSIT: the Eclipse Temurin JRE release
# jdk-<JRE_VERSION>, checked against its published SHA-256.
JRE_VERSION=17.0.20.1+1

# PDF.js: the mozilla/pdf.js commit the image builds (text, metadata and image
# goldens) and the source of the pdfjs corpus (its test/pdfs tree plus the
# linked PDFs its test manifest lists). The newest master commit whose test
# tree matches the provisioned pdfjs corpus.
PDFJS_REVISION=1591ddfa8d0dfda931812cd7b654e12442c14c22

# pdfcpu CLI: bookmarks, merge and merge-empty goldens. The release publishes
# one Linux archive per architecture, and the image installs its own
# architecture's, checked against the SHA-256 pinned here, which is the hash
# the release lists in its checksums.txt. The build refuses an archive that
# does not match, so overriding PDFCPU_VERSION needs the hash of the building
# architecture overridden with it.
PDFCPU_VERSION=0.12.1
PDFCPU_SHA256_AMD64=8f6304e6d39493cace031f9b8d82829a794f5f691ea092d6169596f8a14eeeb8
PDFCPU_SHA256_ARM64=8ab8f8a309110fde449eb190e220703d9239da7c9311074444711569ad8a85cf

# Mustang CLI: facturx-validity goldens, and the CII extraction KoSIT reads.
MUSTANG_VERSION=2.23.0

# KoSIT validator, its XRechnung scenarios bundle, and the EN 16931 CII XSLT
# swapped into the bundle: facturx-schematron goldens.
KOSIT_VERSION=1.6.2
XRECHNUNG_CONFIG_TAG=v2026-01-31
XRECHNUNG_CONFIG_ASSET=xrechnung-3.0.2-validator-configuration-2026-01-31.zip
EN16931_VERSION=1.3.16

# poppler: pdftoppm renders the render goldens, and the host's pdfsig and
# pdftoppm serve live checks at the same release (`make corpus-tools`). The
# image builds the release tarball, checked against the SHA-256 pinned here
# (sha256sum of poppler-<POPPLER_VERSION>.tar.xz from
# poppler.freedesktop.org), so overriding POPPLER_VERSION needs the hash
# overridden with it. The release needs CMake 3.28, C++23 and FreeType 2.13,
# which the Node image's Debian release lacks, so it builds in a
# debian:<POPPLER_DEBIAN_RELEASE>-slim stage pinned by its multi-platform
# index digest, which also supplies the fonts pdftoppm substitutes for the
# ones a PDF does not embed.
POPPLER_VERSION=26.09.0
POPPLER_SHA256=8059eadb6805340768f138c465b57f8164c92b4a0773c37ef031ea6c0d987b2e
POPPLER_DEBIAN_RELEASE=trixie
POPPLER_DEBIAN_IMAGE_DIGEST=sha256:a29215f6a35e51e22adffa17f89e9d2ef06214e64a2bad10d765c46aea49f11f

# poppler-data: the CMaps of the Adobe CJK character collections and their
# CID-to-Unicode tables, without which pdftoppm draws no glyph of a font of
# Adobe-GB1, -CNS1, -Japan1 or -Korea1 that has no /ToUnicode, and none of a
# font whose /Encoding names or uses one of their CMaps ("Missing language
# pack"). The image installs the release tarball, checked against the SHA-256
# pinned here (sha256sum of poppler-data-<POPPLER_DATA_VERSION>.tar.gz from
# poppler.freedesktop.org), so overriding the version needs the hash with it.
POPPLER_DATA_VERSION=0.4.12
POPPLER_DATA_SHA256=c835b640a40ce357e1b83666aabd95edffa24ddddd49b8daff63adb851cdab74

# Noto Sans CJK: the fonts pdftoppm draws an unembedded font of a CJK
# character collection with, matched through fontconfig by the language the
# collection names (ja, ko, zh-cn, zh-tw). The image installs the Regular
# face of each region's subset OpenType font from the notofonts/noto-cjk tag
# Sans<NOTO_CJK_SANS_VERSION> (SIL Open Font License 1.1), each checked
# against the SHA-256 pinned here, so overriding the version needs the four
# hashes with it.
NOTO_CJK_SANS_VERSION=2.004
NOTO_SANS_JP_SHA256=dff723ba59d57d136764a04b9b2d03205544f7cd785a711442d6d2d085ac5073
NOTO_SANS_KR_SHA256=69975a0ac8472717870aefeab0a4d52739308d90856b9955313b2ad5e0148d68
NOTO_SANS_SC_SHA256=faa6c9df652116dde789d351359f3d7e5d2285a2b2a1f04a2d7244df706d5ea9
NOTO_SANS_TC_SHA256=5bab0cb3c1cf89dde07c4a95a4054b195afbcfe784d69d75c340780712237537

# Corpus sources.
#
# veraPDF/veraPDF-corpus commit behind the verapdf corpus.
VERAPDF_CORPUS_REVISION=49de56cd987929932c9e4fbbbe67d052bf44ef83
# pdf-association/pdf20examples commit behind the pdf20 corpus.
PDF20_REVISION=c20f2c17bfcc4baab7cfe62e70fae64caf14d5fa
# pdfcpu/pdfcpu commit whose sample and test PDFs form the pdfcpu corpus.
PDFCPU_CORPUS_REVISION=b869d66d4696106521d36d2928d21b4169effe52
# ZUGFeRD/corpus commit behind the facturx corpus.
FACTURX_CORPUS_REVISION=8a8d7330f67c5d77bd6f1095d629f3e6e25ce1ae
# Govdocs1 thread archives behind the govdocs corpus, comma-separated. The
# archives are static (last modified 2020).
GOVDOCS_THREADS=000,100,200,300,400

# Local tools. The image installs none of these: `make corpus-tools` compares
# the copies on PATH against them, with veraPDF, Node, Java and poppler above,
# since live checks and fixture builds run on the host.
QPDF_VERSION=12.4.1
PIKEPDF_VERSION=9.11.0
# fontTools records the TrueType and CFF outline goldens of
# pkg/internal/typography: `make outline-goldens` installs this release in a
# throwaway virtualenv, so the host copy only matters to `make corpus-tools`.
FONTTOOLS_VERSION=4.60.2
# Pillow records the ICC transform goldens of pkg/internal/graphics/icc through
# the littleCMS it bundles (Pillow 11.3.0 wheels carry littleCMS 2.17, the last
# release for the Python 3.9 the host provides): `make icc-goldens` installs
# this release in a throwaway virtualenv, so the host copy only matters to
# `make corpus-tools`.
PILLOW_VERSION=11.3.0
# The fonts the litho/text corpus builder converts its sources with
# (test/integration/corpus/litho/text/build): `make text-fixtures` downloads each
# archive into test/integration/testdata/fonts, refuses one whose SHA-256 is not
# the one pinned here, and builds with that directory alone, so two machines
# write the same PDFs. The Noto Sans CJK faces come from the
# NOTO_CJK_SANS_VERSION release and hashes above, at the URLs the image
# installs them from. The committed PDFs embed what they draw; only a rebuild
# needs these. Liberation 2.1.5 (SIL Open Font License 1.1): the release's
# TrueType tarball, which the release links as an issue attachment rather than
# a release asset. DejaVu 2.37 (Bitstream Vera licence): the release's TrueType
# tarball.
LIBERATION_FONTS_VERSION=2.1.5
LIBERATION_FONTS_URL=https://github.com/liberationfonts/liberation-fonts/files/7261482/liberation-fonts-ttf-2.1.5.tar.gz
LIBERATION_FONTS_SHA256=7191c669bf38899f73a2094ed00f7b800553364f90e2637010a69c0e268f25d0
DEJAVU_FONTS_VERSION=2.37
DEJAVU_FONTS_URL=https://github.com/dejavu-fonts/dejavu-fonts/releases/download/version_2_37/dejavu-fonts-ttf-2.37.tar.bz2
DEJAVU_FONTS_SHA256=fa9ca4d13871dd122f61258a80d01751d603b4d3ee14095d65453b4e846e17d7
# Noto Sans CJK Regular, the OpenType Collection of the NOTO_CJK_SANS_VERSION
# release (Sans/OTC/NotoSansCJK-Regular.ttc at the tag, SIL Open Font License
# 1.1): the face the Gotenberg image draws CJK text with (Debian's
# fonts-noto-cjk 1:20240730 installs the same bytes), its JP, KR, SC, TC and
# HK families named "Noto Sans CJK". The region subset faces above name
# their families "Noto Sans JP" and the rest, which no CJK fallback asks
# for, so without it an unlabelled Chinese line drew with Noto Sans SC where
# Chromium draws Noto Sans CJK JP.
NOTO_SANS_CJK_OTC_SHA256=b76b0433203017ca80401b2ee0dd69350349871c4b19d504c34dbdd80541690a
# Noto Sans Thai 2.002 and Noto Sans Devanagari 2.007 (SIL Open Font License
# 1.1): the release archives of notofonts/thai and notofonts/devanagari, of
# which `corpus fetch` keeps the hinted static Regular and Bold TrueType faces
# and OFL.txt. They give Thai and Devanagari text a face, as the Noto faces
# of the Gotenberg image do for Chromium.
NOTO_SANS_THAI_VERSION=2.002
NOTO_SANS_THAI_URL=https://github.com/notofonts/thai/releases/download/NotoSansThai-v2.002/NotoSansThai-v2.002.zip
NOTO_SANS_THAI_SHA256=af889cc673fc714060ce5e4e088fbad32aa4c0571a19958efeaff128a22da485
NOTO_SANS_DEVANAGARI_VERSION=2.007
NOTO_SANS_DEVANAGARI_URL=https://github.com/notofonts/devanagari/releases/download/NotoSansDevanagari-v2.007/NotoSansDevanagari-v2.007.zip
NOTO_SANS_DEVANAGARI_SHA256=820c7da45b1e63562cb41c0a8cac5d9a4202312043a3a040ed1325857ef469b1
# Carlito 20230309 and Caladea 20200211 (SIL Open Font License 1.1): the
# faces the Gotenberg image's fontconfig substitutes for Calibri and Cambria
# (Debian's fonts-crosextra-carlito 20230309-2 and fonts-crosextra-caladea
# 20200211-2), from the orig tarballs of those Debian packages, whose TrueType
# files are byte for byte the ones the image installs. `corpus fetch` keeps
# the four TrueType faces of each and OFL.txt.
CARLITO_FONTS_VERSION=20230309
CARLITO_FONTS_URL=https://deb.debian.org/debian/pool/main/f/fonts-crosextra-carlito/fonts-crosextra-carlito_20230309.orig.tar.gz
CARLITO_FONTS_SHA256=72f4f92c4e71c82ba261230ae7aa2e7a3f5fa85a3e8e820288d7eeb1ae55f6dc
CALADEA_FONTS_VERSION=20200211
CALADEA_FONTS_URL=https://deb.debian.org/debian/pool/main/f/fonts-crosextra-caladea/fonts-crosextra-caladea_20200211.orig.tar.gz
CALADEA_FONTS_SHA256=2737242dbeb1e7fc728a9e3ef5509af3513666a826f4d40205c2e5ce3a7768ea
# Noto Sans 20201225 (SIL Open Font License 1.1): the face the Gotenberg
# image's fontconfig gives a family it does not install (Tahoma, Century
# Gothic, Segoe UI), from Debian's fonts-noto-core 20201225-2, the package the
# image installs, whose TrueType files are byte for byte the image's.
# `corpus fetch` keeps the four NotoSans faces and the package's copyright
# file as LICENSE.
NOTO_SANS_CORE_VERSION=20201225
NOTO_SANS_CORE_URL=https://deb.debian.org/debian/pool/main/f/fonts-noto/fonts-noto-core_20201225-2_all.deb
NOTO_SANS_CORE_SHA256=97978d09b68445fcf85342b106cd2e812d7813e3d5626f9884a5f344c3a55973
# OpenSymbol 102.13 (Mozilla Public License 2.0): LibreOffice's symbol font,
# which Impress draws most bullets with, from Debian's fonts-opensymbol
# 4:102.13+LibO26.8.2.2-2~bpo13+1, the package the image installs, whose
# opens___.ttf is byte for byte the image's. The URL is the package's
# permanent address on snapshot.debian.org, by its SHA-1. `corpus fetch`
# keeps opens___.ttf and the package's copyright file as LICENSE.
OPENSYMBOL_VERSION=102.13
OPENSYMBOL_URL=https://snapshot.debian.org/file/72084fdf68bcb8040b761f38e0a40a1d0d90b8ae
OPENSYMBOL_SHA256=9b71d7ef41bf9c84c8dca3c5b1b1a1dca8873fae6bc6530a90cfbd8ed8db1b5c
# web-platform-tests: the commit the wpt corpus's reftests come from.
# `make corpus-fetch CORPUS_NAME=wpt` downloads each file wpt/files.sha256 lists from
# raw.githubusercontent.com at this commit into test/integration/testdata/wpt,
# and refuses one whose SHA-256 is not the one listed there; Ahem, the font the
# tests draw with, goes to test/integration/testdata/fonts/ahem. WPT is under
# the 3-Clause BSD License (W3C test suite licence).
WPT_COMMIT=f39abf33574db32e6313d905a118386ac2766562
# resvg: the commit, the v0.49.0 tag, whose SVG tests and reference PNGs the
# resvg corpus scores. `make corpus-fetch CORPUS_NAME=resvg` downloads each file
# resvg/files.sha256 lists from raw.githubusercontent.com at this commit into
# test/integration/testdata/resvg, and the Noto fonts the text tests draw with
# into test/integration/testdata/fonts/resvg, refusing a file whose SHA-256
# is not the listed one. resvg is under the MIT or Apache 2.0 licence; the
# Noto fonts under the SIL Open Font License 1.1.
RESVG_COMMIT=66ee0dc7d787d7e0b0ab3085b7849f78838cf2ba
# WeasyPrint: the release whose draw tests the weasyprint corpus extracts.
# `make weasyprint-fixtures` downloads the GitHub source tarball of the tag,
# checks it against WEASYPRINT_SHA256, and extracts the fixtures from it;
# the test font it writes to test/integration/testdata/fonts/weasyprint must
# hash to WEASYPRINT_FONT_SHA256. WeasyPrint is under the 3-Clause BSD License.
WEASYPRINT_VERSION=70.0
WEASYPRINT_SHA256=dd3e50a83d8e21a80c1271fdd16cb4c234d96e03906971aea41e3f1b82c49b74
WEASYPRINT_FONT_SHA256=adf277806fcb685de996a48f8728fbff1bd6502f475d12a5e2546589dd95108d
# Gotenberg: the image `make html-references` converts the html corpora's
# sources with, whose Chromium PDFs are their committed references, and whose
# LibreOffice route `make office-references` builds the Office corpora's
# references with.
GOTENBERG_IMAGE=gotenberg/gotenberg:9.0.0
# LibreOffice core: the commit of the libreoffice-26.8.2.2 tag, the release the
# GOTENBERG_IMAGE runs (its soffice reports LibreOffice 26.8.2.2), whose test
# documents the libreoffice corpora score: Writer's for libreoffice/docx and
# libreoffice/odt, Calc's and the charts' for libreoffice/xlsx, ods and csv,
# Impress's, DrawingML's and the charts' for libreoffice/pptx and odp. `make
# corpus-fetch CORPUS_NAME=libreoffice` downloads each file libreoffice/<format>/files.sha256
# lists from raw.githubusercontent.com at this commit into
# test/integration/testdata/libreoffice/<format>/sources, refusing a file
# whose SHA-256 is not the listed one. The documents are under the Mozilla
# Public License 2.0 (some also under the LGPL 3.0 or later), fetched for
# testing and never committed. `make office-references` converts them, and the
# gotenberg corpora's sources, with the GOTENBERG_IMAGE's LibreOffice route.
LIBREOFFICE_CORE_COMMIT=9dea406ab7695df6325b11b0e19fdca8db4b7276
# Apache POI: the trunk commit whose test documents the poi corpora score
# (test-data/, Apache License 2.0, legal/LICENSE and legal/NOTICE fetched
# beside them). `make corpus-fetch CORPUS_NAME=poi` downloads each file
# poi/<format>/files.sha256 lists from raw.githubusercontent.com at this
# commit into test/integration/testdata/poi/<format>/sources, refusing a file
# whose SHA-256 is not the listed one; they are never committed.
POI_COMMIT=519e0a3c3945364e8ea75c172fe1a15fb6d4a202
# Open XML SDK: the main commit whose test documents the openxmlsdk corpora
# score (test/DocumentFormat.OpenXml.Tests.Assets/assets/TestDataStorage, MIT
# licence, LICENSE fetched beside them), most written by Microsoft Office.
# `make corpus-fetch CORPUS_NAME=openxmlsdk` downloads them as poi's are; they
# are never committed.
OPENXMLSDK_COMMIT=431ab05cf160248cc3885a4a766026d4f8243792
