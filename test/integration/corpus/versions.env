# Pinned versions of every tool and corpus source the corpus provisioning uses.
#
# One KEY=VALUE per line; `#` starts a comment line. Values carry no spaces or
# quotes. `corpus init` passes every entry except the local-tool pins to
# `docker build` as --build-arg, and the image hands the corpus revisions to
# the download scripts. An environment variable of the same name overrides a
# pin for one invocation:
#
#   VERAPDF_VERSION=1.30.2 make corpus-init
#
# Overriding a version without its digest drops the digest, so the image is
# pulled by tag. Provisioning records the resolved versions in
# testdata/<corpus>/versions.json, and `corpus run`, `baseline` and `check`
# refuse goldens recorded with other versions. A bump therefore means
# re-provisioning the goldens that depend on it and recapturing the baseline:
# see test/integration/README.md, "Tool versions".
#
# Every tool pin names a release, and every corpus revision is a tag or a
# commit SHA, never a branch.

# veraPDF CLI: the verapdf/cli image tagged v<VERAPDF_VERSION>, pinned to one
# build by its manifest digest (Docker Hub, pushed 2026-10-07). This build
# reports core, validation-model and apps 1.30.3, apps built 2026-10-07 13:52
# UTC, the build behind the compliance goldens.
VERAPDF_VERSION=1.30.3
VERAPDF_IMAGE_DIGEST=sha256:d565095c67a083e693aebf7d1a15784007370571053fc1aa5b502665b9a78f9c

# Node.js: the node:<NODE_VERSION>-<NODE_DEBIAN_RELEASE> base image, pinned by
# its multi-platform index digest. It also fixes the Debian release the apt
# utilities (git, curl, unzip, jq, parallel) come from.
NODE_VERSION=24.21.0
NODE_DEBIAN_RELEASE=bookworm
NODE_IMAGE_DIGEST=sha256:64af3819f9275802414d7cdc38c27e9d82bd564dec4d4da87d008255d36c63b4

# Java runtime for veraPDF, Mustang and KoSIT: the Eclipse Temurin JRE release
# jdk-<JRE_VERSION>, checked against its published SHA-256.
JRE_VERSION=17.0.20.1+1

# PDF.js: the mozilla/pdf.js commit the image builds (text, metadata and image
# goldens) and the source of the pdfjs corpus (its test/pdfs tree plus the
# linked PDFs its test manifest lists). The newest master commit whose test
# tree matches the provisioned pdfjs corpus.
PDFJS_REVISION=1591ddfa8d0dfda931812cd7b654e12442c14c22

# pdfcpu CLI: bookmarks, merge and merge-empty goldens. The release publishes
# one Linux archive per architecture, and the image installs its own
# architecture's, checked against the SHA-256 pinned here, which is the hash
# the release lists in its checksums.txt. The build refuses an archive that
# does not match, so overriding PDFCPU_VERSION needs the hash of the building
# architecture overridden with it.
PDFCPU_VERSION=0.12.1
PDFCPU_SHA256_AMD64=8f6304e6d39493cace031f9b8d82829a794f5f691ea092d6169596f8a14eeeb8
PDFCPU_SHA256_ARM64=8ab8f8a309110fde449eb190e220703d9239da7c9311074444711569ad8a85cf

# Mustang CLI: facturx-validity goldens, and the CII extraction KoSIT reads.
MUSTANG_VERSION=2.23.0

# KoSIT validator, its XRechnung scenarios bundle, and the EN 16931 CII XSLT
# swapped into the bundle: facturx-schematron goldens.
KOSIT_VERSION=1.6.2
XRECHNUNG_CONFIG_TAG=v2026-01-31
XRECHNUNG_CONFIG_ASSET=xrechnung-3.0.2-validator-configuration-2026-01-31.zip
EN16931_VERSION=1.3.16

# poppler: pdftoppm renders the render goldens, and the host's pdfsig and
# pdftoppm serve live checks at the same release (`make corpus-tools`). The
# image builds the release tarball, checked against the SHA-256 pinned here
# (sha256sum of poppler-<POPPLER_VERSION>.tar.xz from
# poppler.freedesktop.org), so overriding POPPLER_VERSION needs the hash
# overridden with it. The release needs CMake 3.28, C++23 and FreeType 2.13,
# which the Node image's Debian release lacks, so it builds in a
# debian:<POPPLER_DEBIAN_RELEASE>-slim stage pinned by its multi-platform
# index digest, which also supplies the fonts pdftoppm substitutes for the
# ones a PDF does not embed.
POPPLER_VERSION=26.09.0
POPPLER_SHA256=8059eadb6805340768f138c465b57f8164c92b4a0773c37ef031ea6c0d987b2e
POPPLER_DEBIAN_RELEASE=trixie
POPPLER_DEBIAN_IMAGE_DIGEST=sha256:a29215f6a35e51e22adffa17f89e9d2ef06214e64a2bad10d765c46aea49f11f

# poppler-data: the CMaps of the Adobe CJK character collections and their
# CID-to-Unicode tables, without which pdftoppm draws no glyph of a font of
# Adobe-GB1, -CNS1, -Japan1 or -Korea1 that has no /ToUnicode, and none of a
# font whose /Encoding names or uses one of their CMaps ("Missing language
# pack"). The image installs the release tarball, checked against the SHA-256
# pinned here (sha256sum of poppler-data-<POPPLER_DATA_VERSION>.tar.gz from
# poppler.freedesktop.org), so overriding the version needs the hash with it.
POPPLER_DATA_VERSION=0.4.12
POPPLER_DATA_SHA256=c835b640a40ce357e1b83666aabd95edffa24ddddd49b8daff63adb851cdab74

# Noto Sans CJK: the fonts pdftoppm draws an unembedded font of a CJK
# character collection with, matched through fontconfig by the language the
# collection names (ja, ko, zh-cn, zh-tw). The image installs the Regular
# face of each region's subset OpenType font from the notofonts/noto-cjk tag
# Sans<NOTO_CJK_SANS_VERSION> (SIL Open Font License 1.1), each checked
# against the SHA-256 pinned here, so overriding the version needs the four
# hashes with it.
NOTO_CJK_SANS_VERSION=2.004
NOTO_SANS_JP_SHA256=dff723ba59d57d136764a04b9b2d03205544f7cd785a711442d6d2d085ac5073
NOTO_SANS_KR_SHA256=69975a0ac8472717870aefeab0a4d52739308d90856b9955313b2ad5e0148d68
NOTO_SANS_SC_SHA256=faa6c9df652116dde789d351359f3d7e5d2285a2b2a1f04a2d7244df706d5ea9
NOTO_SANS_TC_SHA256=5bab0cb3c1cf89dde07c4a95a4054b195afbcfe784d69d75c340780712237537

# Corpus sources.
#
# veraPDF/veraPDF-corpus commit behind the verapdf corpus.
VERAPDF_CORPUS_REVISION=49de56cd987929932c9e4fbbbe67d052bf44ef83
# pdf-association/pdf20examples commit behind the pdf20 corpus.
PDF20_REVISION=c20f2c17bfcc4baab7cfe62e70fae64caf14d5fa
# pdfcpu/pdfcpu commit whose sample and test PDFs form the pdfcpu corpus.
PDFCPU_CORPUS_REVISION=b869d66d4696106521d36d2928d21b4169effe52
# ZUGFeRD/corpus commit behind the facturx corpus.
FACTURX_CORPUS_REVISION=8a8d7330f67c5d77bd6f1095d629f3e6e25ce1ae
# Govdocs1 thread archives behind the govdocs corpus, comma-separated. The
# archives are static (last modified 2020).
GOVDOCS_THREADS=000,100,200,300,400

# Local tools. The image installs none of these: `make corpus-tools` compares
# the copies on PATH against them, with veraPDF, Node, Java and poppler above,
# since live checks and fixture builds run on the host.
QPDF_VERSION=12.4.1
PIKEPDF_VERSION=9.11.0
# fontTools records the TrueType and CFF outline goldens of
# pkg/internal/typography: `make outline-goldens` installs this release in a
# throwaway virtualenv, so the host copy only matters to `make corpus-tools`.
FONTTOOLS_VERSION=4.60.2
# Pillow records the ICC transform goldens of pkg/internal/graphics/icc through
# the littleCMS it bundles (Pillow 11.3.0 wheels carry littleCMS 2.17, the last
# release for the Python 3.9 the host provides): `make icc-goldens` installs
# this release in a throwaway virtualenv, so the host copy only matters to
# `make corpus-tools`.
PILLOW_VERSION=11.3.0
