e-info><dc:creator>Grace Hopper</dc:creator><dc:date>2026-01-03T09:00:00</dc:date></office:change-info></text:insertion></text:changed-region><text:changed-region xml:id="ct13" text:id="ct13"><text:insertion><office:change-info><dc:creator>Ada Lovelace</dc:creator><dc:date>2026-01-03T09:00:00</dc:date></office:change-info></text:insertion></text:changed-region><text:changed-region xml:id="ct14" text:id="ct14"><text:deletion><office:change-info><dc:creator>Ada Lovelace</dc:creator><dc:date>2026-01-03T09:00:00</dc:date></office:change-info></text:deletion></text:changed-region><text:changed-region xml:id="ct15" text:id="ct15"><text:deletion><office:change-info><dc:creator>Ada Lovelace</dc:creator><dc:date>2026-01-03T09:00:00</dc:date></office:change-info></text:deletion></text:changed-region><text:changed-region xml:id="ct16" text:id="ct16"><text:deletion><office:change-info><dc:creator>Ada Lovelace</dc:creator><dc:date>2026-01-03T09:00:00</dc:date></office:change-info></text:deletion></text:changed-region><text:changed-region xml:id="ct17" text:id="ct17"><text:insertion><office:change-info><dc:creator>Ada Lovelace</dc:creator><dc:date>2026-01-03T09:00:00</dc:date></office:change-info></text:insertion></text:changed-region><text:changed-region xml:id="ct18" text:id="ct18"><text:insertion><office:change-info><dc:creator>Ada Lovelace</dc:creator><dc:date>2026-01-03T09:00:00</dc:date></office:change-info></text:insertion></text:changed-region></text:tracked-changes><text:p text:style-name="Heading">Change bars</text:p><text:p text:style-name="Standard">A plain line without a change.</text:p><text:p text:style-name="Narrow">Head rule: alpha <text:change-start text:change-id="ct1"/>bravo<text:change-end text:change-id="ct1"/> charlie delta echo</text:p><text:p text:style-name="Narrow">Tail rule: alpha bravo ch<text:change-start text:change-id="ct2"/>arlie delta<text:change-end text:change-id="ct2"/> echo foxtrot golf</text:p><text:p text:style-name="Narrow">Mid rule: alpha bravo <text:change-start text:change-id="ct3"/>char<text:change-end text:change-id="ct3"/>lie delta echo</text:p><text:p text:style-name="Standard">Formatting: <text:change-start text:change-id="ct4"/><text:span text:style-name="B">now bold</text:span><text:change-end text:change-id="ct4"/>, and a deletion: the <text:change text:change-id="ct5"/>fox.</text:p><text:p text:style-name="Standard">A footnote holds a change<text:note text:id="n1" text:note-class="footnote"><text:note-citation>1</text:note-citation><text:note-body><text:p text:style-name="Footnote">Footnote <text:change-start text:change-id="ct6"/>inserted words<text:change-end text:change-id="ct6"/> here.</text:p></text:note-body></text:note>.</text:p><text:section text:style-name="Sect2" text:name="S1"><text:p text:style-name="Standard">Column one <text:change-start text:change-id="ct7"/>inserted in column one<text:change-end text:change-id="ct7"/> The quick brown fox jumps over the lazy dog by the river bank. The quick brown fox jumps over the lazy dog by the river bank. </text:p><text:p text:style-name="Standard">Column two The quick brown fox jumps over the lazy dog by the river bank. The quick brown fox jumps over the lazy dog by the river bank. <text:change-start text:change-id="ct8"/>inserted in column two<text:change-end text:change-id="ct8"/> end.</text:p></text:section><text:p text:style-name="Standard">Moved: <text:change text:change-id="ct9"/>Stays.</text:p><text:p text:style-name="Standard">Destination: <text:change-start text:change-id="ct10"/>This sentence moves.<text:change-end text:change-id="ct10"/></text:p><text:p text:style-name="Standard">Tracked rows:</text:p><table:table table:name="Rows" table:style-name="Tbl"><table:table-column table:style-name="Col" table:number-columns-repeated="3"/><table:table-row><table:table-cell table:style-name="Cell" office:value-type="string"><text:p text:style-name="Standard">kept</text:p></table:table-cell><table:table-cell table:style-name="Cell" of