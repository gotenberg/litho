<office:styles><style:default-style style:family="paragraph"><style:paragraph-properties fo:margin-top="0in" fo:margin-bottom="0.111in" fo:line-height="108%"/><style:text-properties style:font-name="Calibri" fo:font-size="11pt" fo:language="en" fo:country="US"/></style:default-style><style:style style:name="Standard" style:family="paragraph" style:class="text"><style:paragraph-properties fo:text-align="justify"/></style:style><style:style style:name="Heading_20_1" style:display-name="Heading 1" style:family="paragraph" style:parent-style-name="Standard" style:default-outline-level="1"><style:paragraph-properties fo:margin-top="0.167in" fo:margin-bottom="0.056in" fo:text-align="start" fo:keep-with-next="always"/><style:text-properties style:font-name="Cambria" fo:font-size="16pt" fo:color="#2F5496"/></style:style><style:style style:name="Heading_20_2" style:display-name="Heading 2" style:family="paragraph" style:parent-style-name="Standard" style:default-outline-level="2"><style:paragraph-properties fo:margin-top="0.083in" fo:margin-bottom="0.056in" fo:text-align="start" fo:keep-with-next="always"/><style:text-properties style:font-name="Cambria" fo:font-size="13pt" fo:color="#2F5496"/></style:style><style:style style:name="Quote" style:family="paragraph" style:parent-style-name="Standard"><style:paragraph-properties fo:margin-left="0.5in" fo:margin-right="0.5in" fo:text-align="start"/><style:text-properties style:font-name="Times New Roman" fo:font-size="12pt" fo:font-style="italic"/></style:style><style:style style:name="Caption" style:family="paragraph" style:parent-style-name="Standard"><style:paragraph-properties fo:text-align="center"/><style:text-properties fo:font-size="9pt" fo:font-style="italic" fo:color="#44546A"/></style:style><style:style style:name="Table_20_Contents" style:display-name="Table Contents" style:family="paragraph"><style:paragraph-properties fo:margin-bottom="0in"/><style:text-properties style:font-name="Arial" fo:font-size="10pt"/></style:style><style:style style:name="Table_20_Heading" style:display-name="Table Heading" style:family="paragraph" style:parent-style-name="Table_20_Contents"><style:text-properties fo:font-weight="bold"/></style:style><style:style style:name="Header" style:family="paragraph" style:parent-style-name="Standard"><style:paragraph-properties fo:text-align="end"/><style:text-properties style:font-name="Cambria" fo:color="#1F4E79"/></style:style><style:style style:name="Footer" style:family="paragraph" style:parent-style-name="Standard"><style:paragraph-properties fo:text-align="center"/></style:style></office:styles>
<office:automatic-styles><style:page-layout style:name="pm1"><style:page-layout-properties fo:page-width="8.5in" fo:page-height="11in" style:print-orientation="portrait" fo:margin-top="0.5in" fo:margin-bottom="0.5in" fo:margin-left="1in" fo:margin-right="1in"/><style:header-style><style:header-footer-properties fo:min-height="0.5in" fo:margin-bottom="0.2in"/></style:header-style><style:footer-style><style:header-footer-properties fo:min-height="0.5in" fo:margin-top="0.2in"/></style:footer-style></style:page-layout><style:page-layout style:name="pm2"><style:page-layout-properties fo:page-width="8.5in" fo:page-height="11in" style:print-orientation="portrait" fo:margin-top="0.5in" fo:margin-bottom="0.5in" fo:margin-left="1in" fo:margin-right="1in"/><style:header-style><style:header-footer-properties fo:min-height="0.5in" fo:margin-bottom="0.2in"/></style:header-style><style:footer-style><style:header-footer-properties fo:min-height="0.5in" fo:margin-top="0.2in"/></style:footer-style></style:page-layout><style:style style:name="PartTwo" style:family="paragraph" style:parent-style-name="Heading_20_1"/><style:style style:name="Tbl" style:family="table"><style:table-properties style:width="6.5in" style:rel-width="100%" table:align="margins" fo:margin-bottom="0.111in"/></style:style><style:style style:name="TblCol" style:family="table-column"><style:table-column-properties style:rel-column-width="16383*"/></style:style><style:style style:name="TblHead" style:family="table-cell"><style:table-cell-properties fo:background-color="#D9E1F2" fo:padding="0.04in" fo:border="0.5pt solid #000000"/></style:style><style:style style:name="TblCell" style:family="table-cell"><style:table-cell-properties fo:padding="0.04in" fo:border="0.5pt solid #000000"/></style:style><style:style style:name="fr1" style:family="graphic"><style:graphic-properties style:vertical-pos="top" style:vertical-rel="baseline" style:horizontal-pos="center" style:horizontal-rel="paragraph"/></style:style><style:style style:name="PicPara" style:family="paragraph" style:parent-style-name="Standard"><style:paragraph-properties fo:text-align="center"/></style:style></office:automatic-styles>
<office:master-styles><style:master-page style:name="Standard" style:page-layout-name="pm1"><style:header><text:p text:style-name="Header">Paper sizes and the printed page</text:p></style:header><style:footer><text:p text:style-name="Footer">Page <text:page-number text:select-page="current">1</text:page-number> of <text:page-count>1</text:page-count></text:p></style:footer></style:master-page><style:master-page style:name="Second" style:page-layout-name="pm2"><style:header><text:p text:style-name="Header">Paper sizes and the printed page</text:p></style:header><style:footer><text:p text:style-name="Footer">Page <text:page-number text:select-page="current">1</text:page-number> of <text:page-count>1</text:page-count></text:p></style:footer></style:master-page></office:master-styles>
<office:body><office:text><text:h text:style-name="Heading_20_1" text:outline-level="1">1. Paper and the printed page</text:h><text:p text:style-name="Standard">A document meets its reader on a sheet of paper or on a screen that pretends to be one. The size of that sheet decides where every line ends, where every page breaks and how much of a table fits across. A converter that reads the size wrong moves every word that follows, so the paper is the first thing a faithful conversion must get right.</text:p><text:p text:style-name="Standard">Two families of sizes share the world. The ISO 216 series starts from a sheet of one square metre whose sides keep the ratio of one to the square root of two, so that halving a sheet gives the next size with the same shape. North America keeps the inch sizes of its paper mills: Letter, Legal, Tabloid and Executive, whose shapes owe nothing to one another.</text:p><text:p text:style-name="Standard">Orientation turns a sheet on its side. A portrait page is taller than it is wide; a landscape page is the same sheet turned a quarter, which suits a wide table, a chart with many columns or a slide. The sheet does not change, only the direction the text runs across it.</text:p><text:h text:style-name="Heading_20_2" text:outline-level="2">1.1 How a section states its paper</text:h><text:p text:style-name="Standard">A word processor stores the page size with each section of the document, together with its margins, its header and its footer. When a section ends, the next one may change the size, turn the page or both, so a single file can mix a portrait report with a landscape appendix printed on a larger sheet.</text:p><text:p text:style-name="Quote">The page is the unit of reading. A reader remembers that a passage sat at the top of a left-hand page long after the words themselves have faded, and a converter that moves the break moves that memory with it.</text:p><text:p text:style-name="Standard">A spreadsheet states its paper per sheet, by a numbered code from a table of paper sizes, with an orientation and a scale. A presentation states one slide size for the whole deck, and each slide is drawn on a page of exactly that size.</text:p><text:p text:style-name="PicPara"><draw:frame draw:style-name="fr1" draw:name="Picture 1" text:anchor-type="as-char" svg:width="3in" svg:height="1.5in"><draw:image><office:binary-data></office:binary-data></draw:image><svg:desc>Three coloured shapes in a frame</svg:desc></draw:frame></text:p><text:p text:style-name="Caption">A picture placed inline with the text keeps its size on every paper.</text:p><text:h text:style-name="PartTwo" text:outline-level="1">2. Measures that follow the width</text:h><text:p text:style-name="Standard">The measure is the length of a line of text. On a narrow sheet such as A5 the measure shrinks and a paragraph takes more lines; on a wide sheet such as A3 in landscape the measure grows and the same paragraph takes fewer. Every page break after the first moves accordingly, which is why a document must be laid out again, not scaled, when the paper changes.</text:p><text:p text:style-name="Standard">Headings keep with the paragraph that follows them, so a heading never sits alone at the foot of a page. Tables split between rows, and a row that fits on no page is cut where the page ends. Pictures stay with the line that holds them and push that line to the next page when they do not fit.</text:p><table:table table:name="Papers" table:style-name="Tbl"><table:table-column table:style-name="TblCol" table:number-columns-repeated="4"/><table:table-header-rows><table:table-row><table:table-cell table:style-name="TblHead" office:value-type="string"><text:p text:style-name="Table_20_Heading">Paper</text:p></table:table-cell><table:table-cell table:style-name="TblHead" office:value-type="string"><text:p text:style-name="Table_20_Heading">Series</text:p></table:table-cell><table:table-cell table:style-name="TblHead" office:value-type="string"><text:p text:style-name="Table_20_Heading">Width</text:p></table:table-cell><table:table-cell table:style-name="TblHead" office:value-type="string"><text:p text:style-name="Table_20_Heading">Height</text:p></table:table-cell></table:table-row></table:table-header-rows><table:table-row><table:table-cell table:style-name="TblCell" office:value-type="string"><text:p text:style-name="Table_20_Contents">A3</text:p></table:table-cell><table:table-cell table:style-name="TblCell" office:value-type="string"><text:p text:style-name="Table_20_Contents">ISO 216</text:p></table:table-cell><table:table-cell table:style-name="TblCell" office:value-type="string"><text:p text:style-name="Table_20_Contents">297 mm</text:p></table:table-cell><table:table-cell table:style-name="TblCell" office:value-type="string"><text:p text:style-name="Table_20_Contents">420 mm</text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="TblCell" office:value-type="string"><text:p text:style-name="Table_20_Contents">A4</text:p></table:table-cell><table:table-cell table:style-name="TblCell" office:value-type="string"><text:p text:style-name="Table_20_Contents">ISO 216</text:p></table:table-cell><table:table-cell table:style-name="TblCell" office:value-type="string"><text:p text:style-name="Table_20_Contents">210 mm</text:p></table:table-cell><table:table-cell table:style-name="TblCell" office:value-type="string"><text:p text:style-name="Table_20_Contents">297 mm</text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="TblCell" office:value-type="string"><text:p text:style-name="Table_20_Contents">A5</text:p></table:table-cell><table:table-cell table:style-name="TblCell" office:value-type="string"><text:p text:style-name="Table_20_Contents">ISO 216</text:p></table:table-cell><table:table-cell table:style-name="TblCell" office:value-type="string"><text:p text:style-name="Table_20_Contents">148 mm</text:p></table:table-cell><table:table-cell table:style-name="TblCell" office:value-type="string"><text:p text:style-name="Table_20_Contents">210 mm</text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="TblCell" office:value-type="string"><text:p text:style-name="Table_20_Contents">B5</text:p></table:table-cell><table:table-cell table:style-name="TblCell" office:value-type="string"><text:p text:style-name="Table_20_Contents">ISO 216</text:p></table:table-cell><table:table-cell table:style-name="TblCell" office:value-type="string"><text:p text:style-name="Table_20_Contents">176 mm</text:p></table:table-cell><table:table-cell table:style-name="TblCell" office:value-type="string"><text:p text:style-name="Table_20_Contents">250 mm</text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="TblCell" office:value-type="string"><text:p text:style-name="Table_20_Contents">Letter</text:p></table:table-cell><table:table-cell table:style-name="TblCell" office:value-type="string"><text:p text:style-name="Table_20_Contents">ANSI</text:p></table:table-cell><table:table-cell table:style-name="TblCell" office:value-type="string"><text:p text:style-name="Table_20_Contents">8.5 in</text:p></table:table-cell><table:table-cell table:style-name="TblCell" office:value-type="string"><text:p text:style-name="Table_20_Contents">11 in</text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="TblCell" office:value-type="string"><text:p text:style-name="Table_20_Contents">Legal</text:p></table:table-cell><table:table-cell table:style-name="TblCell" office:value-type="string"><text:p text:style-name="Table_20_Contents">ANSI</text:p></table:table-cell><table:table-cell table:style-name="TblCell" office:value-type="string"><text:p text:style-name="Table_20_Contents">8.5 in</text:p></table:table-cell><table:table-cell table:style-name="TblCell" office:value-type="string"><text:p text:style-name="Table_20_Contents">14 in</text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="TblCell" office:value-type="string"><text:p text:style-name="Table_20_Contents">Tabloid</text:p></table:table-cell><table:table-cell table:style-name="TblCell" office:value-type="string"><text:p text:style-name="Table_20_Contents">ANSI</text:p></table:table-cell><table:table-cell table:style-name="TblCell" office:value-type="string"><text:p text:style-name="Table_20_Contents">11 in</text:p></table:table-cell><table:table-cell table:style-name="TblCell" office:value-type="string"><text:p text:style-name="Table_20_Contents">17 in</text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="TblCell" office:value-type="string"><text:p text:style-name="Table_20_Contents">Executive</text:p></table:table-cell><table:table-cell table:style-name="TblCell" office:value-type="string"><text:p text:style-name="Table_20_Contents">ANSI</text:p></table:table-cell><table:table-cell table:style-name="TblCell" office:value-type="string"><text:p text:style-name="Table_20_Contents">7.25 in</text:p></table:table-cell><table:table-cell table:style-name="TblCell" office:value-type="string"><text:p text:style-name="Table_20_Contents">10.5 in</text:p></table:table-cell></table:table-row></table:table><text:p text:style-name="Standard">The table above takes the whole width of the text column, so its columns grow and shrink with the paper while its rows keep their height. A narrow sheet wraps the longer cells onto a second line; a wide sheet leaves room to spare.</text:p><text:h text:style-name="Heading_20_2" text:outline-level="2">2.1 Headers, footers and page numbers</text:h><text:p text:style-name="Standard">The header and the footer repeat on every page of a section. The footer of this document carries the number of the page and the count of pages, which both change with the paper: a document that takes three pages on Letter may take five on A5 and two on A3.</text:p><text:p text:style-name="Standard">Margins stay fixed when the paper changes, so the text column gains or loses exactly what the sheet gains or loses. One inch on each side leaves a column of six and a half inches on Letter, a little more than six inches on A4 and barely four on A5.</text:p><text:p text:style-name="Quote">Executive paper, seven and a quarter inches by ten and a half, is the smallest of the common American sizes and the one most often forgotten by software that lists only Letter and Legal.</text:p><text:h text:style-name="Heading_20_1" text:outline-level="1">3. Checking a conversion</text:h><text:p text:style-name="Standard">A conversion is judged by how it looks. The reference engine prints the document on the paper it names; the converter prints it on the same paper; both are drawn and compared page by page. The size of each page must agree to within a point, the count of pages must agree, and the ink on each page must fall in the same places.</text:p><text:p text:style-name="Standard">A mistake in reading the size shows at once on the page box of the very first page. A mistake in laying text out at another width shows only further down, where a line breaks one word early and every later line follows. Both are found by printing the same document on many papers, in both orientations, and comparing every page.</text:p><text:p text:style-name="Standard">The papers covered here are A3, A4, A5 and B5 from the ISO series, and Letter, Legal, Tabloid and Executive from the American sizes, each in portrait and in landscape. Sixteen documents, each a copy of this one with only its paper changed, cover the whole range from the smallest to the largest common sheet.</text:p><text:p text:style-name="Standard">When the caller names a paper, it replaces the paper of every section, and the landscape switch turns every page that is not already turned. A document that names no paper at all prints on the default paper of the engine, which for the references is Letter.</text:p></office:text></office:body></office:document>
