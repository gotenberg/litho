le-name="Bar" draw:z-index="11" svg:x="49.65pt" svg:y="297.00pt" svg:width="0pt" svg:height="13.80pt"/><draw:rect text:anchor-type="page" text:anchor-page-number="1" draw:style-name="Bar" draw:z-index="12" svg:x="49.65pt" svg:y="316.45pt" svg:width="0pt" svg:height="13.80pt"/><draw:rect text:anchor-type="page" text:anchor-page-number="1" draw:style-name="Bar" draw:z-index="13" svg:x="49.65pt" svg:y="335.90pt" svg:width="0pt" svg:height="13.80pt"/><draw:rect text:anchor-type="page" text:anchor-page-number="1" draw:style-name="Bar" draw:z-index="14" svg:x="49.65pt" svg:y="385.60pt" svg:width="0pt" svg:height="13.80pt"/><draw:rect text:anchor-type="page" text:anchor-page-number="1" draw:style-name="Bar" draw:z-index="15" svg:x="49.65pt" svg:y="408.40pt" svg:width="0pt" svg:height="13.80pt"/><draw:rect text:anchor-type="page" text:anchor-page-number="1" draw:style-name="Bar" draw:z-index="16" svg:x="49.65pt" svg:y="431.20pt" svg:width="0pt" svg:height="13.80pt"/><draw:rect text:anchor-type="page" text:anchor-page-number="1" draw:style-name="Bar" draw:z-index="17" svg:x="49.65pt" svg:y="479.65pt" svg:width="0pt" svg:height="13.80pt"/><draw:rect text:anchor-type="page" text:anchor-page-number="1" draw:style-name="Bar" draw:z-index="18" svg:x="49.65pt" svg:y="505.30pt" svg:width="0pt" svg:height="13.80pt"/><text:h text:style-name="Heading_20_1" text:outline-level="1">Tracked changes</text:h><text:p text:style-name="Standard">Insertion: the <text:span text:style-name="InsAda">quick </text:span>brown fox.</text:p><text:p text:style-name="Standard">Deletion: the <text:span text:style-name="DelAda">slow </text:span>brown fox.</text:p><text:p text:style-name="Standard">Replacement: the fox is <text:span text:style-name="DelAda">red</text:span><text:span text:style-name="InsAda">brown</text:span>.</text:p><text:p text:style-name="Standard">Two authors: <text:span text:style-name="InsAda">Ada adds </text:span><text:span text:style-name="InsGrace">Grace adds </text:span><text:span text:style-name="DelGrace">Grace deletes</text:span></text:p><text:p text:style-name="Standard">Formatting change: <text:span text:style-name="FmtAda">now bold</text:span>, was plain.</text:p><text:p text:style-name="Standard">Inserted paragraph break splits this paragraph.</text:p><text:p text:style-name="Standard">Second half after the inserted break.</text:p><text:p text:style-name="Standard">Deleted paragraph break joins this paragraph</text:p><text:p text:style-name="Standard"><text:s/>with the next one.</text:p><text:p text:style-name="Standard"><text:span text:style-name="DelGrace">A whole quoted paragraph, deleted.</text:span></text:p><text:p text:style-name="Standard">A paragraph after a deleted quotation.</text:p><text:p text:style-name="Standard">Range deletion: the <text:span text:style-name="DelAda">very </text:span>end.</text:p><text:p text:style-name="Quotations"><text:span text:style-name="InsGrace">A whole quoted paragraph, inserted.</text:span></text:p><text:p text:style-name="Standard">A paragraph after an inserted quotation.</text:p><text:h text:style-name="Heading_20_2" text:outline-level="2">Tables</text:h><text:p text:style-name="Standard">A deleted table follows.</text:p><table:table table:name="Deleted" table:style-name="Tbl"><table:table-column table:style-name="TblCol" table:number-columns-repeated="3"/><table:table-row><table:table-cell table:style-name="TblCellDel" office:value-type="string"><text:p text:style-name="Table_20_Contents"><text:span text:style-name="DelAda">deleted table</text:span></text:p></table:table-cell><table:table-cell table:style-name="TblCellDel" office:value-type="string"><text:p text:style-name="Table_20_Contents"><text:span text:style-name="DelAda">deleted table</text:span></text:p></table:table-cell><table:table-cell table:style-name="TblCellDel" office:value-type="string"><text:p text:style-name="Table_20_Contents"><text:span text:style-name="DelAda">deleted table</text:span></text:p></table:table-cell></table:table-row></table:table><text:p text:style-name="Standard">After the deleted table.</text:p><table:table table:name="Rows" table:style-name="Tbl"><table:table-column table:style-name="TblCol" table:number-columns-repeated="3"/><table:table-row><table:table-cell table:style-name="TblCell" office:value-type="string"><text:p text:style-name="Table_20_Contents">kept</text:p></table:table-cell><table:table-cell table:style-name="TblCell" office:value-type="string"><text:p text:style-name="Table_20_Contents">kept</text:p></table:table-cell><table:table-cell table:style-name="TblCell" office:value-type="string"><text:p text:style-name="Table_20_Contents">kept</text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="TblCellDel" office:value-type="string"><text:p text:style-name="Table_20_Contents"><text:span text:style-name="DelAda">deleted row</text:span></text:p></table:table-cell><table:table-cell table:style-name="TblCellDel" office:value-type="string"><text:p text:style-name="Table_20_Contents"><text:span text:style-name="DelAda">deleted row</text:span></text:p></table:table-cell><table:table-cell table:style-name="TblCellDel" office:value-type="string"><text:p text:style-name="Table_20_Contents"><text:span text:style-name="DelAda">deleted row</text:span></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="TblCellIns" office:value-type="string"><text:p text:style-name="Table_20_Contents"><text:span text:style-name="InsGrace">inserted row</text:span></text:p></table:table-cell><table:table-cell table:style-name="TblCellIns" office:value-type="string"><text:p text:style-name="Table_20_Contents"><text:span text:style-name="InsGrace">inserted row</text:span></text:p></table:table-cell><table:table-cell table:style-name="TblCellIns" office:value-type="string"><text:p text:style-name="Table_20_Contents"><text:span text:style-name="InsAda">inserted row</text:span></text:p></table:table-cell></table:table-row></table:table><text:p text:style-name="Standard">Last paragraph.</text:p></office:text></office:body>
