andard"><style:paragraph-properties fo:text-align="end" style:writing-mode="rl-tb"/></style:style><style:style style:name="RL" style:family="paragraph" style:parent-style-name="Standard" style:list-style-name="LR"><style:paragraph-properties style:writing-mode="rl-tb"/></style:style><text:list-style style:name="LR"><text:list-level-style-number text:level="1" style:num-format="1" style:num-suffix="."><style:list-level-properties text:list-level-position-and-space-mode="label-alignment"><style:list-level-label-alignment text:label-followed-by="listtab" text:list-tab-stop-position="10mm" fo:text-indent="-6mm" fo:margin-left="10mm"/></style:list-level-properties></text:list-level-style-number></text:list-style></office:automatic-styles>
<office:master-styles><style:master-page style:name="Standard" style:page-layout-name="pm1"/></office:master-styles>
<office:body><office:text><text:h text:style-name="RH1" text:outline-level="1">הכרזה לכל באי עולם בדבר זכויות האדם</text:h><text:h text:style-name="RH2" text:outline-level="2">סעיף א.</text:h><text:p text:style-name="R">כל בני אדם נולדו בני חורין ושווים בערכם ובזכויותיהם. כולם חוננו בתבונה ובמצפון, לפיכך חובה עליהם לנהוג איש ברעהו ברוח של אחוה.</text:p><text:h text:style-name="RH2" text:outline-level="2">מספרים ותאריכים</text:h><text:p text:style-name="R">ההכרזה התקבלה ב־10 בדצמבר 1948 בפריז.</text:p><text:p text:style-name="R">תאריך הקבלה: 10.12.1948, או 1948-12-10.</text:p><text:p text:style-name="R">סעיפים 1–3 עוסקים בחירות, בשוויון ובביטחון.</text:p><text:p text:style-name="R">יותר מ־50% מהמדינות החברות הצביעו בעד.</text:p><text:h text:style-name="RH2" text:outline-level="2">מילים לטיניות</text:h><text:p text:style-name="R">האו״ם (United Nations) מונה 193 מדינות חברות.</text:p><text:p text:style-name="R">בגרסה האנגלית נקרא הסעיף Article 1, ובצרפתית Article premier.</text:p><text:h text:style-name="RH2" text:outline-level="2">סוגריים</text:h><text:p text:style-name="R">(א) חירות; [ב] שוויון; {ג} אחווה.</text:p><text:h text:style-name="RH2" text:outline-level="2">רשימה וטבלה</text:h><text:list text:style-name="LR"><text:list-item><text:p text:style-name="RL">חירות</text:p></text:list-item><text:list-item><text:p text:style-name="RL">שוויון</text:p></text:list-item><text:list-item><text:p text:style-name="RL">אחווה</text:p></text:list-item></text:list><table:table table:name="T1" table:style-name="Tb"><table:table-column table:style-name="Tb.A"/><table:table-column table:style-name="Tb.B"/><table:table-column table:style-name="Tb.C"/><table:table-row><table:table-cell table:style-name="Tc" office:value-type="string"><text:p text:style-name="R">סעיף</text:p></table:table-cell><table:table-cell table:style-name="Tc" office:value-type="string"><text:p text:style-name="R">נושא</text:p></table:table-cell><table:table-cell table:style-name="Tc" office:value-type="string"><text:p text:style-name="R">שנה</text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Tc" office:value-type="string"><text:p text:style-name="RN">1</text:p></table:table-cell><table:table-cell table:style-name="Tc" office:value-type="string"><text:p text:style-name="R">חירות ושוויון</text:p></table:table-cell><table:table-cell table:style-name="Tc" office:value-type="string"><text:p text:style-name="RN">1948</text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Tc" office:value-type="string"><text:p text:style-name="RN">3</text:p></table:table-cell><table:table-cell table:style-name="Tc" office:value-type="string"><text:p text:style-name="R">חיים, חירות וביטחון</text:p></table:table-cell><table:table-cell table:style-name="Tc" office:value-type="string"><text:p text:style-name="RN">1948</text:p></table:table-cell></table:table-row></table:table></office:text></office:body>
</office:document>
