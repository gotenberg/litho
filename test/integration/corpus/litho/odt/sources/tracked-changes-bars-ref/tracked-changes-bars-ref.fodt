<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:draw="urn:oasis:names:tc:opendocument:xmlns:drawing:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" xmlns:svg="urn:oasis:names:tc:opendocument:xmlns:svg-compatible:1.0" xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:loext="urn:org:documentfoundation:names:experimental:office:xmlns:loext:1.0" office:version="1.3" office:mimetype="application/vnd.oasis.opendocument.text"><office:meta><dc:title>Tracked change bars, marked</dc:title></office:meta><office:font-face-decls><style:font-face style:name="Liberation Serif" svg:font-family="'Liberation Serif'" style:font-family-generic="roman"/><style:font-face style:name="Liberation Sans" svg:font-family="'Liberation Sans'" style:font-family-generic="swiss"/></office:font-face-decls><office:styles><style:default-style style:family="paragraph"><style:paragraph-properties fo:margin-bottom="0.2cm"/><style:text-properties style:font-name="Liberation Serif" fo:font-size="12pt" fo:language="en" fo:country="US"/></style:default-style><style:style style:name="Standard" style:family="paragraph" style:class="text"/><style:style style:name="Heading" style:family="paragraph" style:parent-style-name="Standard"><style:text-properties style:font-name="Liberation Sans" fo:font-size="18pt" fo:font-weight="bold"/></style:style><style:style style:name="Narrow" style:family="paragraph" style:parent-style-name="Standard"><style:paragraph-properties fo:margin-right="13cm"/></style:style><style:style style:name="Footnote" style:family="paragraph" style:parent-style-name="Standard"><style:text-properties fo:font-size="10pt"/></style:style></office:styles><office:automatic-styles><style:style style:name="B" style:family="text"><style:text-properties fo:font-weight="bold"/></style:style><style:style style:name="Sect2" style:family="section"><style:section-properties><style:columns fo:column-count="2" fo:column-gap="1cm"/></style:section-properties></style:style><style:style style:name="Tbl" style:family="table"><style:table-properties style:width="12cm" table:align="left"/></style:style><style:style style:name="Col" style:family="table-column"><style:table-column-properties style:column-width="4cm"/></style:style><style:style style:name="RowTracked" style:family="table-row"><style:table-row-properties loext:text-changes-only="false"/></style:style><style:style style:name="Cell" style:family="table-cell"><style:table-cell-properties fo:padding="0.1cm" fo:border="0.5pt solid #000000"/></style:style><style:style style:name="CellIns" style:family="table-cell"><style:table-cell-properties fo:background-color="#e1f2fa" fo:padding="0.1cm" fo:border="0.5pt solid #000000"/></style:style><style:style style:name="CellDel" style:family="table-cell"><style:table-cell-properties fo:background-color="#fce6f4" fo:padding="0.1cm" fo:border="0.5pt solid #000000"/></style:style><style:style style:name="Bar" style:family="graphic"><style:graphic-properties draw:stroke="solid" svg:stroke-width="0cm" svg:stroke-color="#000000" draw:fill="none" style:wrap="run-through" style:run-through="foreground" style:vertical-pos="from-top" style:vertical-rel="page" style:horizontal-pos="from-left" style:horizontal-rel="page"/></style:style><style:style style:name="InsA" style:family="text"><style:text-properties fo:color="#c69200" style:text-underline-style="solid" style:text-underline-width="auto" style:text-underline-color="font-color"/></style:style><style:style style:name="DelA" style:family="text"><style:text-properties fo:color="#c69200" style:text-line-through-style="solid" style:text-line-through-type="single"/></style:style><style:style style:name="FmtA" style:family="text"><style:text-properties fo:color="#c69200" fo:font-weight="bold"/></style:style><style:style style:name="InsG" style:family="text"><style:text-properties fo:color="#0646a2" style:text-underline-style="solid" style:text-underline-width="auto" style:text-underline-color="font-color"/></style:style><style:style style:name="DelG" style:family="text"><style:text-properties fo:color="#0646a2" style:text-line-through-style="solid" style:text-line-through-type="single"/></style:style><style:style style:name="FmtG" style:family="text"><style:text-properties fo:color="#0646a2" fo:font-weight="bold"/></style:style><style:style style:name="MoveTo" style:family="text"><style:text-properties fo:color="#008000" style:text-underline-style="solid" style:text-underline-type="double" style:text-underline-width="auto" style:text-underline-color="font-color"/></style:style><style:style style:name="MoveFrom" style:family="text"><style:text-properties fo:color="#008000" style:text-line-through-style="solid" style:text-line-through-type="double"/></style:style><style:page-layout style:name="pm1"><style:page-layout-properties fo:page-width="8.5in" fo:page-height="11in" style:print-orientation="portrait" fo:margin-top="2cm" fo:margin-bottom="2cm" fo:margin-left="3cm" fo:margin-right="2cm"/></style:page-layout></office:automatic-styles><office:master-styles><style:master-page style:name="Standard" style:page-layout-name="pm1"/></office:master-styles><office:body><office:text><draw:rect text:anchor-type="page" text:anchor-page-number="1" draw:style-name="Bar" draw:z-index="0" svg:x="78.00pt" svg:y="102.50pt" svg:width="0pt" svg:height="13.80pt"/><draw:rect text:anchor-type="page" text:anchor-page-number="1" draw:style-name="Bar" draw:z-index="1" svg:x="78.00pt" svg:y="116.30pt" svg:width="0pt" svg:height="13.80pt"/><draw:rect text:anchor-type="page" text:anchor-page-number="1" draw:style-name="Bar" draw:z-index="2" svg:x="78.00pt" svg:y="163.35pt" svg:width="0pt" svg:height="13.80pt"/><draw:rect text:anchor-type="page" text:anchor-page-number="1" draw:style-name="Bar" draw:z-index="3" svg:x="78.00pt" svg:y="210.40pt" svg:width="0pt" svg:height="13.80pt"/><draw:rect text:anchor-type="page" text:anchor-page-number="1" draw:style-name="Bar" draw:z-index="4" svg:x="78.00pt" svg:y="243.65pt" svg:width="0pt" svg:height="13.80pt"/><draw:rect text:anchor-type="page" text:anchor-page-number="1" draw:style-name="Bar" draw:z-index="5" svg:x="78.00pt" svg:y="282.55pt" svg:width="0pt" svg:height="13.80pt"/><draw:rect text:anchor-type="page" text:anchor-page-number="1" draw:style-name="Bar" draw:z-index="6" svg:x="327.25pt" svg:y="323.95pt" svg:width="0pt" svg:height="13.80pt"/><draw:rect text:anchor-type="page" text:anchor-page-number="1" draw:style-name="Bar" draw:z-index="7" svg:x="78.00pt" svg:y="343.40pt" svg:width="0pt" svg:height="13.80pt"/><draw:rect text:anchor-type="page" text:anchor-page-number="1" draw:style-name="Bar" draw:z-index="8" svg:x="78.00pt" svg:y="362.85pt" svg:width="0pt" svg:height="13.80pt"/><draw:rect text:anchor-type="page" text:anchor-page-number="1" draw:style-name="Bar" draw:z-index="9" svg:x="78.00pt" svg:y="430.75pt" svg:width="0pt" svg:height="13.80pt"/><draw:rect text:anchor-type="page" text:anchor-page-number="1" draw:style-name="Bar" draw:z-index="10" svg:x="78.00pt" svg:y="456.40pt" svg:width="0pt" svg:height="13.80pt"/><draw:rect text:anchor-type="page" text:anchor-page-number="1" draw:style-name="Bar" draw:z-index="11" svg:x="78.00pt" svg:y="482.05pt" svg:width="0pt" svg:height="13.80pt"/><draw:rect text:anchor-type="page" text:anchor-page-number="1" draw:style-name="Bar" draw:z-index="12" svg:x="78.00pt" svg:y="504.85pt" svg:width="0pt" svg:height="13.80pt"/><draw:rect text:anchor-type="page" text:anchor-page-number="1" draw:style-name="Bar" draw:z-index="13" svg:x="78.00pt" svg:y="527.65pt" svg:width="0pt" svg:height="13.80pt"/><draw:rect text:anchor-type="page" text:anchor-page-number="1" draw:style-name="Bar" draw:z-index="14" svg:x="78.00pt" svg:y="550.45pt" svg:width="0pt" svg:height="13.80pt"/><draw:rect text:anchor-type="page" text:anchor-page-number="1" draw:style-name="Bar" draw:z-index="15" svg:x="78.00pt" svg:y="723.75pt" svg:width="0pt" svg:height="11.55pt"/><text:p text:style-name="Heading">Change bars</text:p><text:p text:style-name="Standard">A plain line without a change.</text:p><text:p text:style-name="Narrow">Head rule: alpha <text:span text:style-name="InsA">bravo</text:span> charlie delta echo</text:p><text:p text:style-name="Narrow">Tail rule: alpha bravo ch<text:span text:style-name="InsA">arlie delta</text:span> echo foxtrot golf</text:p><text:p text:style-name="Narrow">Mid rule: alpha bravo <text:span text:style-name="InsA">char</text:span>lie delta echo</text:p><text:p text:style-name="Standard">Formatting: <text:span text:style-name="FmtA">now bold</text:span>, and a deletion: the <text:span text:style-name="DelA">slow </text:span>fox.</text:p><text:p text:style-name="Standard">A footnote holds a change<text:note text:id="n1" text:note-class="footnote"><text:note-citation>1</text:note-citation><text:note-body><text:p text:style-name="Footnote">Footnote <text:span text:style-name="InsA">inserted words</text:span> here.</text:p></text:note-body></text:note>.</text:p><text:section text:style-name="Sect2" text:name="S1"><text:p text:style-name="Standard">Column one <text:span text:style-name="InsA">inserted in column one</text:span> The quick brown fox jumps over the lazy dog by the river bank. The quick brown fox jumps over the lazy dog by the river bank. </text:p><text:p text:style-name="Standard">Column two The quick brown fox jumps over the lazy dog by the river bank. The quick brown fox jumps over the lazy dog by the river bank. <text:span text:style-name="InsA">inserted in column two</text:span> end.</text:p></text:section><text:p text:style-name="Standard">Moved: <text:span text:style-name="MoveFrom">This sentence moves. </text:span>Stays.</text:p><text:p text:style-name="Standard">Destination: <text:span text:style-name="MoveTo">This sentence moves.</text:span></text:p><text:p text:style-name="Standard">Tracked rows:</text:p><table:table table:name="Rows" table:style-name="Tbl"><table:table-column table:style-name="Col" table:number-columns-repeated="3"/><table:table-row><table:table-cell table:style-name="Cell" office:value-type="string"><text:p text:style-name="Standard">kept</text:p></table:table-cell><table:table-cell table:style-name="Cell" office:value-type="string"><text:p text:style-name="Standard">kept</text:p></table:table-cell><table:table-cell table:style-name="Cell" office:value-type="string"><text:p text:style-name="Standard">kept</text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="CellIns" office:value-type="string"><text:p text:style-name="Standard"><text:span text:style-name="InsA">inserted</text:span></text:p></table:table-cell><table:table-cell table:style-name="CellIns" office:value-type="string"><text:p text:style-name="Standard"><text:span text:style-name="InsG">inserted</text:span></text:p></table:table-cell><table:table-cell table:style-name="CellIns" office:value-type="string"><text:p text:style-name="Standard"><text:span text:style-name="InsA">inserted</text:span></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="CellDel" office:value-type="string"><text:p text:style-name="Standard"><text:span text:style-name="DelA">deleted</text:span></text:p></table:table-cell><table:table-cell table:style-name="CellDel" office:value-type="string"><text:p text:style-name="Standard"><text:span text:style-name="DelA">deleted</text:span></text:p></table:table-cell><table:table-cell table:style-name="CellDel" office:value-type="string"><text:p text:style-name="Standard"><text:span text:style-name="DelA">deleted</text:span></text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="Cell" office:value-type="string"><text:p text:style-name="Standard"><text:span text:style-name="InsA">text only</text:span></text:p></table:table-cell><table:table-cell table:style-name="Cell" office:value-type="string"><text:p text:style-name="Standard">kept</text:p></table:table-cell><table:table-cell table:style-name="Cell" office:value-type="string"><text:p text:style-name="Standard">kept</text:p></table:table-cell></table:table-row></table:table><text:p text:style-name="Standard">A table inside an insertion follows.</text:p><table:table table:name="Inserted" table:style-name="Tbl"><table:table-column table:style-name="Col" table:number-columns-repeated="3"/><table:table-row><table:table-cell table:style-name="CellIns" office:value-type="string"><text:p text:style-name="Standard"><text:span text:style-name="InsA">in table</text:span></text:p></table:table-cell><table:table-cell table:style-name="CellIns" office:value-type="string"><text:p text:style-name="Standard"><text:span text:style-name="InsA">in table</text:span></text:p></table:table-cell><table:table-cell table:style-name="CellIns" office:value-type="string"><text:p text:style-name="Standard"><text:span text:style-name="InsA">in table</text:span></text:p></table:table-cell></table:table-row></table:table><text:p text:style-name="Standard">After the inserted table.</text:p></office:text></office:body></office:document>
