<office:meta><dc:title>Tracked changes</dc:title></office:meta>
<office:font-face-decls><style:font-face style:name="Liberation Serif" svg:font-family="'Liberation Serif'" style:font-family-generic="roman"/><style:font-face style:name="Liberation Sans" svg:font-family="'Liberation Sans'" style:font-family-generic="swiss"/></office:font-face-decls>
<office:styles><style:default-style style:family="paragraph"><style:paragraph-properties fo:margin-bottom="0.2cm"/><style:text-properties style:font-name="Liberation Serif" fo:font-size="12pt" fo:language="en" fo:country="US"/></style:default-style><style:style style:name="Standard" style:family="paragraph" style:class="text"/><style:style style:name="Heading_20_1" style:display-name="Heading 1" style:family="paragraph" style:parent-style-name="Standard" style:default-outline-level="1"><style:text-properties style:font-name="Liberation Sans" fo:font-size="18pt" fo:font-weight="bold"/></style:style><style:style style:name="Heading_20_2" style:display-name="Heading 2" style:family="paragraph" style:parent-style-name="Standard" style:default-outline-level="2"><style:paragraph-properties fo:margin-top="0.3cm"/><style:text-properties style:font-name="Liberation Sans" fo:font-size="14pt" fo:font-weight="bold"/></style:style><style:style style:name="Quotations" style:family="paragraph" style:parent-style-name="Standard"><style:paragraph-properties fo:margin-left="1cm" fo:text-align="center"/><style:text-properties fo:font-style="italic"/></style:style><style:style style:name="Table_20_Contents" style:display-name="Table Contents" style:family="paragraph" style:parent-style-name="Standard"/></office:styles>
<office:automatic-styles><style:style style:name="T1" style:family="text"><style:text-properties fo:font-weight="bold"/></style:style><style:style style:name="Tbl" style:family="table"><style:table-properties style:width="12cm" table:align="left"/></style:style><style:style style:name="TblCol" style:family="table-column"><style:table-column-properties style:column-width="4cm"/></style:style><style:style style:name="TblRowTracked" style:family="table-row"><style:table-row-properties loext:text-changes-only="false"/></style:style><style:style style:name="TblCell" style:family="table-cell"><style:table-cell-properties fo:padding="0.1cm" fo:border="0.5pt solid #000000"/></style:style><style:page-layout style:name="pm1"><style:page-layout-properties fo:page-width="8.5in" fo:page-height="11in" style:print-orientation="portrait" fo:margin-top="2cm" fo:margin-bottom="2cm" fo:margin-left="2cm" fo:margin-right="2cm"/></style:page-layout></office:automatic-styles>
<office:master-styles><style:master-page style:name="Standard" style:page-layout-name="pm1"/></office:master-styles>
<office:body><office:text><text:tracked-changes text:track-changes="true"><text:changed-region xml:id="ct1" text:id="ct1"><text:insertion><office:change-info><dc:creator>Ada Lovelace</dc:creator><dc:date>2026-01-03T09:00:00</dc:date></office:change-info></text:insertion></text:changed-region><text:changed-region xml:id="ct2" text:id="ct2"><text:deletion><office:change-info><dc:creator>Ada Lovelace</dc:creator><dc:date>2026-01-03T09:00:00</dc:date></office:change-info><text:p text:style-name="Standard">slow </text:p></text:deletion></text:changed-region><text:changed-region xml:id="ct3" text:id="ct3"><text:deletion><office:change-info><dc:creator>Ada Lovelace</dc:creator><dc:date>2026-01-03T09:00:00</dc:date></office:change-info><text:p text:style-name="Standard">red</text:p></text:deletion></text:changed-region><text:changed-region xml:id="ct4" text:id="ct4"><text:insertion><office:change-info><dc:creator>Ada Lovelace</dc:creator><dc:date>2026-01-03T09:00:00</dc:date></office:change-info></text:insertion></text:changed-region><text:changed-region xml:id="ct5" text:id="ct5"><text:insertion><office:change-info><dc:creator>Ada Lovelace</dc:creator><dc:date>2026-01-03T09:00:00</dc:date></office:change-info></text:insertion></text:changed-region><text:changed-region xml:id="ct6" text:id="ct6"><text:insertion><office:change-info><dc:creator>Grace Hopper</dc:creator><dc:date>2026-01-04T09:00:00</dc:date></office:change-info></text:insertion></text:changed-region><text:changed-region xml:id="ct7" text:id="ct7"><text:deletion><office:change-info><dc:creator>Grace Hopper</dc:creator><dc:date>2026-01-04T09:00:00</dc:date></office:change-info><text:p text:style-name="Standard">Grace deletes</text:p></text:deletion></text:changed-region><text:changed-region xml:id="ct8" text:id="ct8"><text:format-change><office:change-info><dc:creator>Ada Lovelace</dc:creator><dc:date>2026-01-03T09:00:00</dc:date></office:change-info></text:format-change></text:changed-region><text:changed-region xml:id="ct9" text:id="ct9"><text:insertion><office:change-info><dc:creator>Ada Lovelace</dc:creator><dc:date>2026-01-03T09:00:00</dc:date></office:change-info></text:insertion></text:changed-region><text:changed-region xml:id="ct10" text:id="ct10"><text:deletion><office:change-info><dc:creator>Ada Lovelace</dc:creator><dc:date>2026-01-03T09:00:00</dc:date></office:change-info><text:p text:style-name="Standard"/><text:p text:style-name="Standard"/></text:deletion></text:changed-region><text:changed-region xml:id="ct11" text:id="ct11"><text:deletion><office:change-info><dc:creator>Grace Hopper</dc:creator><dc:date>2026-01-04T09:00:00</dc:date></office:change-info><text:p text:style-name="Quotations">A whole quoted paragraph, deleted.</text:p><text:p text:style-name="Standard"/></text:deletion></text:changed-region><text:changed-region xml:id="ct12" text:id="ct12"><text:deletion><office:change-info><dc:creator>Ada Lovelace</dc:creator><dc:date>2026-01-03T09:00:00</dc:date></office:change-info></text:deletion></text:changed-region><text:changed-region xml:id="ct13" text:id="ct13"><text:insertion><office:change-info><dc:creator>Grace Hopper</dc:creator><dc:date>2026-01-04T09:00:00</dc:date></office:change-info></text:insertion></text:changed-region><text:changed-region xml:id="ct14" text:id="ct14"><text:deletion><office:change-info><dc:creator>Ada Lovelace</dc:creator><dc:date>2026-01-03T09:00:00</dc:date></office:change-info></text:deletion></text:changed-region><text:changed-region xml:id="ct15" text:id="ct15"><text:deletion><office:change-info><dc:creator>Ada Lovelace</dc:creator><dc:date>2026-01-03T09:00:00</dc:date></office:change-info></text:deletion></text:changed-region><text:changed-region xml:id="ct16" text:id="ct16"><text:deletion><office:change-info><dc:creator>Ada Lovelace</dc:creator><dc:date>2026-01-03T09:00:00</dc:date></office:change-info></text:deletion></text:changed-region><text:changed-region xml:id="ct17" text:id="ct17"><text:insertion><office:change-info><dc:creator>Grace Hopper</dc:creator><dc:date>2026-01-04T09:00:00</dc:date></office:change-info></text:insertion></text:changed-region><text:changed-region xml:id="ct18" text:id="ct18"><text:insertion><office:change-info><dc:creator>Grace Hopper</dc:creator><dc:date>2026-01-04T09:00:00</dc:date></office:change-info></text:insertion></text:changed-region><text:changed-region xml:id="ct19" text:id="ct19"><text:insertion><office:change-info><dc:creator>Ada Lovelace</dc:creator><dc:date>2026-01-03T09:00:00</dc:date></office:change-info></text:insertion></text:changed-region><text:changed-region xml:id="ct20" text:id="ct20"><text:deletion><office:change-info><dc:creator>Ada Lovelace</dc:creator><dc:date>2026-01-03T09:00:00</dc:date></office:change-info></text:deletion></text:changed-region></text:tracked-changes><text:h text:style-name="Heading_20_1" text:outline-level="1">Tracked changes</text:h><text:p text:style-name="Standard">Insertion: the <text:change-start text:change-id="ct1"/>quick <text:change-end text:change-id="ct1"/>brown fox.</text:p><text:p text:style-name="Standard">Deletion: the <text:change text:change-id="ct2"/>brown fox.</text:p><text:p text:style-name="Standard">Replacement: the fox is <text:change text:change-id="ct3"/><text:change-start text:change-id="ct4"/>brown<text:change-end text:change-id="ct4"/>.</text:p><text:p text:style-name="Standard">Two authors: <text:change-start text:change-id="ct5"/>Ada adds <text:change-end text:change-id="ct5"/><text:change-start text:change-id="ct6"/>Grace adds <text:change-end text:change-id="ct6"/><text:change text:change-id="ct7"/></text:p><text:p text:style-name="Standard">Formatting change: <text:change-start text:change-id="ct8"/><text:span text:style-name="T1">now bold</text:span><text:change-end text:change-id="ct8"/>, was plain.</text:p><text:p text:style-name="Standard">Inserted paragraph break splits this paragraph.<text:change-start text:change-id="ct9"/></text:p><text:p text:style-name="Standard"><text:change-end text:change-id="ct9"/>Second half after the inserted break.</text:p><text:p text:style-name="Standard">Deleted paragraph break joins this paragraph<text:change text:change-id="ct10"/> with the next one.</text:p><text:p text:style-name="Standard"><text:change text:change-id="ct11"/>A paragraph after a deleted quotation.</text:p><text:p text:style-name="Standard">Range deletion: the <text:change-start text:change-id="ct12"/>very <text:change-end text:change-id="ct12"/>end.</text:p><text:p text:style-name="Quotations"><text:change-start text:change-id="ct13"/>A whole quoted paragraph, inserted.</text:p><text:p text:style-name="Standard"><text:change-end text:change-id="ct13"/>A paragraph after an inserted quotation.</text:p><text:h text:style-name="Heading_20_2" text:outline-level="2">Tables</text:h><text:p text:style-name="Standard">A deleted table follows.<text:change-start text:change-id="ct14"/></text:p><table:table table:name="Deleted" table:style-name="Tbl"><table:table-column table:style-name="TblCol" table:number-columns-repeated="3"/><table:table-row><table:table-cell table:style-name="TblCell" office:value-type="string"><text:p text:style-name="Table_20_Contents">deleted table</text:p></table:table-cell><table:table-cell table:style-name="TblCell" office:value-type="string"><text:p text:style-name="Table_20_Contents">deleted table</text:p></table:table-cell><table:table-cell table:style-name="TblCell" office:value-type="string"><text:p text:style-name="Table_20_Contents">deleted table</text:p></table:table-cell></table:table-row></table:table><text:p text:style-name="Standard"><text:change-end text:change-id="ct14"/>After the deleted table.</text:p><table:table table:name="Rows" table:style-name="Tbl"><table:table-column table:style-name="TblCol" table:number-columns-repeated="3"/><table:table-row><table:table-cell table:style-name="TblCell" office:value-type="string"><text:p text:style-name="Table_20_Contents">kept</text:p></table:table-cell><table:table-cell table:style-name="TblCell" office:value-type="string"><text:p text:style-name="Table_20_Contents">kept</text:p></table:table-cell><table:table-cell table:style-name="TblCell" office:value-type="string"><text:p text:style-name="Table_20_Contents">kept</text:p></table:table-cell></table:table-row><table:table-row table:style-name="TblRowTracked"><table:table-cell table:style-name="TblCell" office:value-type="string"><text:p text:style-name="Table_20_Contents"><text:change-start text:change-id="ct15"/>deleted row<text:change-end text:change-id="ct15"/></text:p></table:table-cell><table:table-cell table:style-name="TblCell" office:value-type="string"><text:p text:style-name="Table_20_Contents"><text:change-start text:change-id="ct16"/>deleted row<text:change-end text:change-id="ct16"/></text:p></table:table-cell><table:table-cell table:style-name="TblCell" office:value-type="string"><text:p text:style-name="Table_20_Contents"><text:change-start text:change-id="ct20"/>deleted row<text:change-end text:change-id="ct20"/></text:p></table:table-cell></table:table-row><table:table-row table:style-name="TblRowTracked"><table:table-cell table:style-name="TblCell" office:value-type="string"><text:p text:style-name="Table_20_Contents"><text:change-start text:change-id="ct17"/>inserted row<text:change-end text:change-id="ct17"/></text:p></table:table-cell><table:table-cell table:style-name="TblCell" office:value-type="string"><text:p text:style-name="Table_20_Contents"><text:change-start text:change-id="ct18"/>inserted row<text:change-end text:change-id="ct18"/></text:p></table:table-cell><table:table-cell table:style-name="TblCell" office:value-type="string"><text:p text:style-name="Table_20_Contents"><text:change-start text:change-id="ct19"/>inserted row<text:change-end text:change-id="ct19"/></text:p></table:table-cell></table:table-row></table:table><text:p text:style-name="Standard">Last paragraph.</text:p></office:text></office:body>
