<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/">
  <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <rdf:Description xmlns:pdfaid="http://www.aiim.org/pdfa/ns/id/" rdf:about="">
      <pdfaid:part>1</pdfaid:part>
      <pdfaid:conformance>B</pdfaid:conformance>
    </rdf:Description>
    <rdf:Description xmlns:pdfaExtension="http://www.aiim.org/pdfa/ns/extension/" xmlns:pdfaSchema="http://www.aiim.org/pdfa/ns/schema#" xmlns:pdfaProperty="http://www.aiim.org/pdfa/ns/property#" xmlns:pdfaType="http://www.aiim.org/pdfa/ns/type#" xmlns:pdfaField="http://www.aiim.org/pdfa/ns/field#" xmlns:litho="http://example.org/litho/alien#" rdf:about="">
      <pdfaExtension:schemas>
        <rdf:Seq>
          <rdf:li rdf:parseType="Resource">
            <pdfaSchema:namespaceURI>http://example.org/litho/delta#</pdfaSchema:namespaceURI>
            <pdfaSchema:prefix>ldelta</pdfaSchema:prefix>
            <pdfaSchema:property>
              <rdf:Seq>
                <rdf:li rdf:parseType="Resource">
                  <pdfaProperty:name>deltaOne</pdfaProperty:name>
                  <pdfaProperty:valueType>Text</pdfaProperty:valueType>
                  <pdfaProperty:category>external</pdfaProperty:category>
                  <pdfaProperty:description>conforming property</pdfaProperty:description>
                </rdf:li>
              </rdf:Seq>
            </pdfaSchema:property>
          </rdf:li>
          <rdf:li rdf:parseType="Resource">
            <pdfaSchema:schema>Litho Epsilon Schema</pdfaSchema:schema>
            <pdfaSchema:prefix>lepsilon</pdfaSchema:prefix>
            <pdfaSchema:property>
              <rdf:Seq>
                <rdf:li rdf:parseType="Resource">
                  <pdfaProperty:name>epsilonOne</pdfaProperty:name>
                  <pdfaProperty:valueType>Text</pdfaProperty:valueType>
                  <pdfaProperty:category>external</pdfaProperty:category>
                  <pdfaProperty:description>conforming property</pdfaProperty:description>
                </rdf:li>
              </rdf:Seq>
            </pdfaSchema:property>
          </rdf:li>
          <rdf:li rdf:parseType="Resource">
            <pdfaSchema:schema>Litho Zeta Schema</pdfaSchema:schema>
            <pdfaSchema:namespaceURI>http://example.org/litho/zeta#</pdfaSchema:namespaceURI>
            <pdfaSchema:prefix>lzeta</pdfaSchema:prefix>
            <pdfaSchema:property>
              <rdf:Seq>
                <rdf:li rdf:parseType="Resource">
                  <pdfaProperty:name>zetaOne</pdfaProperty:name>
                  <pdfaProperty:valueType>Text</pdfaProperty:valueType>
                  <pdfaProperty:category>external</pdfaProperty:category>
                  <pdfaProperty:description>conforming property</pdfaProperty:description>
                </rdf:li>
              </rdf:Seq>
            </pdfaSchema:property>
            <litho:extra>outside the extension schema vocabulary</litho:extra>
          </rdf:li>
          <rdf:li rdf:parseType="Resource">
            <pdfaSchema:schema>Litho Eta Schema</pdfaSchema:schema>
            <pdfaSchema:namespaceURI>http://example.org/litho/eta#</pdfaSchema:namespaceURI>
            <pdfaSchema:prefix>leta</pdfaSchema:prefix>
            <pdfaSchema:property>
              <rdf:Seq>
                <rdf:li rdf:parseType="Resource">
                  <pdfaProperty:name>etaOne</pdfaProperty:name>
                  <pdfaProperty:valueType>EtaRecord</pdfaProperty:valueType>
                  <pdfaProperty:category>internal</pdfaProperty:category>
                  <pdfaProperty:description>uses the type below</pdfaProperty:description>
                </rdf:li>
              </rdf:Seq>
            </pdfaSchema:property>
            <pdfaSchema:valueType>
              <rdf:Bag>
                <rdf:li rdf:parseType="Resource">
                  <pdfaType:type>EtaRecord</pdfaType:type>
                  <pdfaType:namespaceURI>http://example.org/litho/eta/record#</pdfaType:namespaceURI>
                  <pdfaType:prefix>erec</pdfaType:prefix>
                  <pdfaType:description>conforming value type in a wrong container</pdfaType:description>
                </rdf:li>
              </rdf:Bag>
            </pdfaSchema:valueType>
          </rdf:li>
          <rdf:li rdf:parseType="Resource">
            <pdfaSchema:schema>Litho Theta Schema</pdfaSchema:schema>
            <pdfaSchema:namespaceURI>http://example.org/litho/theta#</pdfaSchema:namespaceURI>
            <pdfaSchema:prefix>ltheta</pdfaSchema:prefix>
            <pdfaSchema:property>
              <rdf:Seq>
                <rdf:li rdf:parseType="Resource">
                  <pdfaProperty:name>thetaOne</pdfaProperty:name>
                  <pdfaProperty:category>external</pdfaProperty:category>
                  <pdfaProperty:description>this property declares no value type</pdfaProperty:description>
                </rdf:li>
                <rdf:li rdf:parseType="Resource">
                  <pdfaProperty:name>thetaTwo</pdfaProperty:name>
                  <pdfaProperty:valueType>Text</pdfaProperty:valueType>
                  <pdfaProperty:category>external</pdfaProperty:category>
                  <pdfaProperty:description>conforming property</pdfaProperty:description>
                </rdf:li>
              </rdf:Seq>
            </pdfaSchema:property>
          </rdf:li>
          <rdf:li rdf:parseType="Resource">
            <pdfaSchema:schema>Litho Iota Schema</pdfaSchema:schema>
            <pdfaSchema:namespaceURI>http://example.org/litho/iota#</pdfaSchema:namespaceURI>
            <pdfaSchema:prefix>liota</pdfaSchema:prefix>
            <pdfaSchema:property>
              <rdf:Seq>
                <rdf:li rdf:parseType="Resource">
                  <pdfaProperty:name>iotaOne</pdfaProperty:name>
                  <pdfaProperty:valueType>Text</pdfaProperty:valueType>
                  <pdfaProperty:category>external</pdfaProperty:category>
                  <pdfaProperty:description>conforming property</pdfaProperty:description>
                </rdf:li>
              </rdf:Seq>
            </pdfaSchema:property>
            <pdfaSchema:valueType>
              <rdf:Seq>
                <rdf:li rdf:parseType="Resource">
                  <pdfaType:namespaceURI>http://example.org/litho/iota/one#</pdfaType:namespaceURI>
                  <pdfaType:prefix>ione</pdfaType:prefix>
                  <pdfaType:description>value type with no name</pdfaType:description>
                </rdf:li>
                <rdf:li rdf:parseType="Resource">
                  <pdfaType:type>IotaTwo</pdfaType:type>
                  <pdfaType:prefix>itwo</pdfaType:prefix>
                  <pdfaType:description>value type with no namespace URI</pdfaType:description>
                </rdf:li>
                <rdf:li rdf:parseType="Resource">
                  <pdfaType:type>IotaThree</pdfaType:type>
                  <pdfaType:namespaceURI>http://example.org/litho/iota/three#</pdfaType:namespaceURI>
                  <pdfaType:description>value type with no prefix</pdfaType:description>
                </rdf:li>
                <rdf:li rdf:parseType="Resource">
                  <pdfaType:type>IotaFour</pdfaType:type>
                  <pdfaType:namespaceURI>http://example.org/litho/iota/four#</pdfaType:namespaceURI>
                  <pdfaType:prefix>ifour</pdfaType:prefix>
                  <pdfaType:description>fields in a wrong container</pdfaType:description>
                  <pdfaType:field>
                    <rdf:Bag>
                      <rdf:li rdf:parseType="Resource">
                        <pdfaField:name>fourOne</pdfaField:name>
                        <pdfaField:valueType>Text</pdfaField:valueType>
                        <pdfaField:description>conforming field</pdfaField:description>
                      </rdf:li>
                    </rdf:Bag>
                  </pdfaType:field>
                </rdf:li>
                <rdf:li rdf:parseType="Resource">
                  <pdfaType:type>IotaFive</pdfaType:type>
                  <pdfaType:namespaceURI>http://example.org/litho/iota/five#</pdfaType:namespaceURI>
                  <pdfaType:prefix>ifive</pdfaType:prefix>
                  <pdfaType:description>value type whose fields carry the defects</pdfaType:description>
                  <pdfaType:field>
                    <rdf:Seq>
                      <rdf:li rdf:parseType="Resource">
                        <pdfaField:name>fiveOne</pdfaField:name>
                        <pdfaField:description>this field declares no value type</pdfaField:description>
                      </rdf:li>
                      <rdf:li rdf:parseType="Resource">
                        <pdfaField:name>fiveTwo</pdfaField:name>
                        <pdfaField:valueType>Text</pdfaField:valueType>
                      </rdf:li>
                      <rdf:li rdf:parseType="Resource">
                        <pdfaField:name>fiveThree</pdfaField:name>
                        <pdfaField:valueType>Text</pdfaField:valueType>
                        <pdfaField:description>conforming field</pdfaField:description>
                      </rdf:li>
                    </rdf:Seq>
                  </pdfaType:field>
                </rdf:li>
                <rdf:li rdf:parseType="Resource">
                  <pdfaType:type>IotaSix</pdfaType:type>
                  <pdfaType:namespaceURI>http://example.org/litho/iota/six#</pdfaType:namespaceURI>
                  <pdfaType:prefix>isix</pdfaType:prefix>
                  <pdfaType:description>fully conforming value type</pdfaType:description>
                  <pdfaType:field>
                    <rdf:Seq>
                      <rdf:li rdf:parseType="Resource">
                        <pdfaField:name>sixOne</pdfaField:name>
                        <pdfaField:valueType>Text</pdfaField:valueType>
                        <pdfaField:description>conforming field</pdfaField:description>
                      </rdf:li>
                    </rdf:Seq>
                  </pdfaType:field>
                </rdf:li>
              </rdf:Seq>
            </pdfaSchema:valueType>
          </rdf:li>
          <rdf:li rdf:parseType="Resource">
            <pdfaSchema:schema>Litho Kappa Schema</pdfaSchema:schema>
            <pdfaSchema:namespaceURI>http://example.org/litho/kappa#</pdfaSchema:namespaceURI>
            <pdfaSchema:prefix>lkappa</pdfaSchema:prefix>
            <pdfaSchema:property>
              <rdf:Seq>
                <rdf:li rdf:parseType="Resource">
                  <pdfaProperty:name>kappaOne</pdfaProperty:name>
                  <pdfaProperty:valueType>KappaRecord</pdfaProperty:valueType>
                  <pdfaProperty:category>external</pdfaProperty:category>
                  <pdfaProperty:description>names the type below</pdfaProperty:description>
                </rdf:li>
              </rdf:Seq>
            </pdfaSchema:property>
            <pdfaSchema:valueType>
              <rdf:Seq>
                <rdf:li rdf:parseType="Resource">
                  <pdfaType:type>KappaRecord</pdfaType:type>
                  <pdfaType:namespaceURI>http://example.org/litho/kappa/record#</pdfaType:namespaceURI>
                  <pdfaType:prefix>krec</pdfaType:prefix>
                  <pdfaType:description>fully conforming value type</pdfaType:description>
                  <pdfaType:field>
                    <rdf:Seq>
                      <rdf:li rdf:parseType="Resource">
                        <pdfaField:name>kappaFieldOne</pdfaField:name>
                        <pdfaField:valueType>Text</pdfaField:valueType>
                        <pdfaField:description>conforming field</pdfaField:description>
                      </rdf:li>
                    </rdf:Seq>
                  </pdfaType:field>
                </rdf:li>
              </rdf:Seq>
            </pdfaSchema:valueType>
          </rdf:li>
        </rdf:Seq>
      </pdfaExtension:schemas>
    </rdf:Description>
  </rdf:RDF>
