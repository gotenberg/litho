<office:body><office:presentation><draw:page draw:name="Slide 1" draw:style-name="dp1" draw:master-page-name="Default"><draw:frame draw:style-name="gr1" svg:x="1.524cm" svg:y="2.032cm" svg:width="16.002cm" svg:height="21.336cm"><draw:text-box><text:p>Slide 1: P01 hotel kilo november quebec tango whiskey zulu charlie foxtrot india lima oscar romeo uniform xray alpha.</text:p></draw:text-box></draw:frame></draw:page><draw:page draw:name="Slide 2" draw:style-name="dp1" draw:master-page-name="Default"><draw:frame draw:style-name="gr1" svg:x="1.524cm" svg:y="2.032cm" svg:width="16.002cm" svg:height="21.336cm"><draw:text-box><text:p>Slide 2: P02 oscar romeo uniform xray alpha delta golf juliet mike papa sierra victor yankee bravo echo hotel.</text:p></draw:text-box></draw:frame></draw:page><draw:page draw:name="Slide 3" draw:style-name="dp1" draw:master-page-name="Default"><draw:frame draw:style-name="gr1" svg:x="1.524cm" svg:y="2.032cm" svg:width="16.002cm" svg:height="21.336cm"><draw:text-box><text:p>Slide 3: P03 victor yankee bravo echo hotel kilo november quebec tango whiskey zulu charlie foxtrot india lima oscar.</text:p></draw:text-box></draw:frame></draw:page></office:presentation></office:body>
