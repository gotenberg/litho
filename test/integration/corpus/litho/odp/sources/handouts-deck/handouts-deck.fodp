<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:draw="urn:oasis:names:tc:opendocument:xmlns:drawing:1.0" xmlns:presentation="urn:oasis:names:tc:opendocument:xmlns:presentation:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" xmlns:svg="urn:oasis:names:tc:opendocument:xmlns:svg-compatible:1.0" xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:meta="urn:oasis:names:tc:opendocument:xmlns:meta:1.0" office:version="1.3" office:mimetype="application/vnd.oasis.opendocument.presentation">
<office:meta><dc:title>Handout deck</dc:title></office:meta>
<office:font-face-decls><style:font-face style:name="Liberation Sans" svg:font-family="'Liberation Sans'" style:font-family-generic="swiss"/></office:font-face-decls>
<office:styles><style:default-style style:family="graphic"><style:graphic-properties draw:stroke="none" draw:fill="none" fo:padding-top="0cm" fo:padding-bottom="0cm" fo:padding-left="0cm" fo:padding-right="0cm"/><style:text-properties style:font-name="Liberation Sans" fo:font-size="18pt" fo:color="#000000" fo:language="en" fo:country="US"/></style:default-style></office:styles>
<office:automatic-styles><style:page-layout style:name="PM1"><style:page-layout-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:margin-left="0cm" fo:margin-right="0cm" fo:page-width="28.0cm" fo:page-height="15.75cm" style:print-orientation="landscape"/></style:page-layout><style:page-layout style:name="PM0"><style:page-layout-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:margin-left="0cm" fo:margin-right="0cm" fo:page-width="21.0cm" fo:page-height="29.7cm" style:print-orientation="portrait"/></style:page-layout><style:style style:name="Ph" style:family="paragraph"><style:text-properties fo:font-size="12pt"/></style:style><style:style style:name="Pr" style:family="paragraph"><style:paragraph-properties fo:text-align="end"/><style:text-properties fo:font-size="12pt"/></style:style><style:style style:name="top" style:family="graphic"><style:graphic-properties draw:stroke="none" draw:fill="none" draw:textarea-vertical-align="top"/></style:style><style:style style:name="bottom" style:family="graphic"><style:graphic-properties draw:stroke="none" draw:fill="none" draw:textarea-vertical-align="bottom"/></style:style><style:style style:name="frame" style:family="graphic"><style:graphic-properties draw:stroke="solid" svg:stroke-color="#c0c0c0" svg:stroke-width="0.0035cm" draw:fill="none"/></style:style><style:style style:name="rule" style:family="graphic"><style:graphic-properties draw:stroke="solid" svg:stroke-color="#000000" svg:stroke-width="0.0035cm" draw:fill="none"/></style:style><style:style style:name="gr1" style:family="graphic"><style:graphic-properties draw:stroke="none" draw:fill="solid" draw:fill-color="#c00000" draw:textarea-vertical-align="middle" draw:auto-grow-height="false" draw:auto-grow-width="false"/></style:style><style:style style:name="gr2" style:family="graphic"><style:graphic-properties draw:stroke="none" draw:fill="solid" draw:fill-color="#e07000" draw:textarea-vertical-align="middle" draw:auto-grow-height="false" draw:auto-grow-width="false"/></style:style><style:style style:name="gr3" style:family="graphic"><style:graphic-properties draw:stroke="none" draw:fill="solid" draw:fill-color="#c0a000" draw:textarea-vertical-align="middle" draw:auto-grow-height="false" draw:auto-grow-width="false"/></style:style><style:style style:name="gr4" style:family="graphic"><style:graphic-properties draw:stroke="none" draw:fill="solid" draw:fill-color="#00a000" draw:textarea-vertical-align="middle" draw:auto-grow-height="false" draw:auto-grow-width="false"/></style:style><style:style style:name="gr5" style:family="graphic"><style:graphic-properties draw:stroke="none" draw:fill="solid" draw:fill-color="#0070c0" draw:textarea-vertical-align="middle" draw:auto-grow-height="false" draw:auto-grow-width="false"/></style:style><style:style style:name="gr6" style:family="graphic"><style:graphic-properties draw:stroke="none" draw:fill="solid" draw:fill-color="#7030a0" draw:textarea-vertical-align="middle" draw:auto-grow-height="false" draw:auto-grow-width="false"/></style:style><style:style style:name="gr7" style:family="graphic"><style:graphic-properties draw:stroke="none" draw:fill="solid" draw:fill-color="#606060" draw:textarea-vertical-align="middle" draw:auto-grow-height="false" draw:auto-grow-width="false"/></style:style><style:style style:name="Pc" style:family="paragraph"><style:paragraph-properties fo:text-align="center"/><style:text-properties fo:font-size="40pt" fo:color="#ffffff"/></style:style><style:style style:name="dp1" style:family="drawing-page"><style:drawing-page-properties presentation:display-header="true" presentation:display-footer="true" presentation:display-date-time="true" presentation:display-page-number="true"/></style:style><style:style style:name="dp2" style:family="drawing-page"><style:drawing-page-properties presentation:display-header="true" presentation:display-footer="true" presentation:display-date-time="true" presentation:display-page-number="true"/></style:style><style:style style:name="dp3" style:family="drawing-page"><style:drawing-page-properties presentation:visibility="hidden" presentation:display-header="true" presentation:display-footer="true" presentation:display-date-time="true" presentation:display-page-number="true"/></style:style></office:automatic-styles>
<office:master-styles><style:handout-master presentation:use-header-name="hdr1" presentation:use-footer-name="ftr1" presentation:use-date-time-name="dtd1" style:page-layout-name="PM0" draw:style-name="dp2"><draw:frame draw:style-name="top" presentation:class="header" svg:x="0cm" svg:y="0cm" svg:width="9cm" svg:height="1.5cm"><draw:text-box><text:p text:style-name="Ph"><presentation:header/></text:p></draw:text-box></draw:frame><draw:frame draw:style-name="top" presentation:class="date-time" svg:x="12cm" svg:y="0cm" svg:width="9cm" svg:height="1.5cm"><draw:text-box><text:p text:style-name="Pr"><presentation:date-time/></text:p></draw:text-box></draw:frame><draw:frame draw:style-name="bottom" presentation:class="footer" svg:x="0cm" svg:y="28.2cm" svg:width="9cm" svg:height="1.5cm"><draw:text-box><text:p text:style-name="Ph"><presentation:footer/></text:p></draw:text-box></draw:frame><draw:frame draw:style-name="bottom" presentation:class="page-number" svg:x="12cm" svg:y="28.2cm" svg:width="9cm" svg:height="1.5cm"><draw:text-box><text:p text:style-name="Pr"><text:page-number>1</text:page-number></text:p></draw:text-box></draw:frame></style:handout-master><style:master-page style:name="Default" style:page-layout-name="PM1" draw:style-name="dp1"/></office:master-styles>
<office:body><office:presentation><presentation:header-decl presentation:name="hdr1">Quarterly review handout</presentation:header-decl><presentation:footer-decl presentation:name="ftr1">Company confidential</presentation:footer-decl><presentation:date-time-decl presentation:name="dtd1" presentation:source="fixed">November 12, 2026</presentation:date-time-decl><draw:page draw:name="Opening" draw:style-name="dp1" draw:master-page-name="Default"><draw:custom-shape draw:style-name="gr1" svg:x="2.54cm" svg:y="2.54cm" svg:width="22.92cm" svg:height="10.67cm"><text:p text:style-name="Pc">Slide 1: Opening</text:p><draw:enhanced-geometry svg:viewBox="0 0 21600 21600" draw:type="rectangle"/></draw:custom-shape></draw:page><draw:page draw:name="Agenda" draw:style-name="dp1" draw:master-page-name="Default"><draw:custom-shape draw:style-name="gr2" svg:x="2.54cm" svg:y="2.54cm" svg:width="22.92cm" svg:height="10.67cm"><text:p text:style-name="Pc">Slide 2: Agenda</text:p><draw:enhanced-geometry svg:viewBox="0 0 21600 21600" draw:type="rectangle"/></draw:custom-shape></draw:page><draw:page draw:name="Market" draw:style-name="dp1" draw:master-page-name="Default"><draw:custom-shape draw:style-name="gr3" svg:x="2.54cm" svg:y="2.54cm" svg:width="22.92cm" svg:height="10.67cm"><text:p text:style-name="Pc">Slide 3: Market</text:p><draw:enhanced-geometry svg:viewBox="0 0 21600 21600" draw:type="rectangle"/></draw:custom-shape></draw:page><draw:page draw:name="Backup" draw:style-name="dp3" draw:master-page-name="Default"><draw:custom-shape draw:style-name="gr4" svg:x="2.54cm" svg:y="2.54cm" svg:width="22.92cm" svg:height="10.67cm"><text:p text:style-name="Pc">Slide 4: Backup</text:p><draw:enhanced-geometry svg:viewBox="0 0 21600 21600" draw:type="rectangle"/></draw:custom-shape></draw:page><draw:page draw:name="Results" draw:style-name="dp1" draw:master-page-name="Default"><draw:custom-shape draw:style-name="gr5" svg:x="2.54cm" svg:y="2.54cm" svg:width="22.92cm" svg:height="10.67cm"><text:p text:style-name="Pc">Slide 5: Results</text:p><draw:enhanced-geometry svg:viewBox="0 0 21600 21600" draw:type="rectangle"/></draw:custom-shape></draw:page><draw:page draw:name="Roadmap" draw:style-name="dp1" draw:master-page-name="Default"><draw:custom-shape draw:style-name="gr6" svg:x="2.54cm" svg:y="2.54cm" svg:width="22.92cm" svg:height="10.67cm"><text:p text:style-name="Pc">Slide 6: Roadmap</text:p><draw:enhanced-geometry svg:viewBox="0 0 21600 21600" draw:type="rectangle"/></draw:custom-shape></draw:page><draw:page draw:name="Questions" draw:style-name="dp1" draw:master-page-name="Default"><draw:custom-shape draw:style-name="gr7" svg:x="2.54cm" svg:y="2.54cm" svg:width="22.92cm" svg:height="10.67cm"><text:p text:style-name="Pc">Slide 7: Questions</text:p><draw:enhanced-geometry svg:viewBox="0 0 21600 21600" draw:type="rectangle"/></draw:custom-shape></draw:page></office:presentation></office:body>
</office:document>
